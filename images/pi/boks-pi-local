#!/bin/sh
# Start pi pointed at a llama.cpp router on the host, when one was found.
#
# pi has llama.cpp router support built in — `/llama` loads, unloads and downloads models on
# the router, and `/model` lists what is loaded — configured by LLAMA_BASE_URL. A prepare
# script cannot set the agent's environment (it is a child process), so
# prepare.d/10-discover-local-models.sh records the router it found and this launcher, which
# becomes pi, exports it.
#
# LLAMA_API_KEY is left to pi's default. If the server needs a key, it stays on the host as
# the local-model secret and the proxy puts it on every request to host.boks.internal; the
# sandbox never holds it.
set -eu

router_file="${HOME}/.pi/agent/.boks-llama-router"
if [ -z "${LLAMA_BASE_URL:-}" ] && [ -r "$router_file" ]; then
	url=$(head -n 1 "$router_file")
	if [ -n "$url" ]; then
		LLAMA_BASE_URL="$url"
		export LLAMA_BASE_URL
	fi
fi

# pi-background-tasks is shipped for its background shell tasks (bg_run and the tools that
# watch and stop them). Its other tools delegate to further agents and run its "Fusion"
# workflows: subagents already covers delegation, and together they cost about 3,800 tokens of
# tool schema and guidance on every request, which a local model's context pays for.
# Only for a session: in front of a subcommand (pi install, pi list, ...) the option turns the
# subcommand's name into a prompt for the model.
case "${1:-}" in
install | remove | uninstall | update | list | config | auth | mcp) exec pi "$@" ;;
esac
exec pi --exclude-tools 'bg_delegate,bg_run_pi_attested,fusion_*' "$@"
