#!/bin/sh
# Install the Boks certificate authority into this guest's trust store.
#
# Boks injects credentials by terminating TLS for the hosts a credential rule names, which
# means the guest is offered a certificate signed by a CA generated on the host. Without
# this, every intercepted request fails verification. `boks ca env` prints the variable
# consumed here.
#
# Doing nothing when the variable is unset is deliberate: an image that refuses to start
# without an injected CA would be unusable for the (common) sandbox that intercepts nothing.
#
# This lives as its own command, not only inside the entrypoint, because the entrypoint is
# not on every path into a sandbox: a persistent sandbox runs an idle keeper as its container
# process and `boks exec` runs the command it was given, so neither passes through it. In
# those cases run `boks exec <sandbox> boks-install-ca` once — the write persists in the
# sandbox's snapshot.
set -eu

# A trust store this process cannot write is a WARNING, not a failure, and the difference
# matters most for images Boks did not build. A sandbox with a workspace runs as the uid that
# owns that workspace on the host, which owns nothing inside an arbitrary image, so this is
# the ordinary case there rather than an exotic one. Boks points every runtime that reads an
# environment variable at the mounted bundle regardless, so such a sandbox is usable; killing
# it over the system store would mean no sandbox at all.
unwritable() {
	echo "boks: cannot write $1 as uid $(id -u); the Boks CA is not in this sandbox's" >&2
	echo "      system trust store. Tools that read SSL_CERT_FILE, CURL_CA_BUNDLE," >&2
	echo "      REQUESTS_CA_BUNDLE or NODE_EXTRA_CA_CERTS still trust it; anything that" >&2
	echo "      reads /etc/ssl/certs directly will not." >&2
}

if [ -z "${BOKS_CA_CERT_B64:-}" ]; then
	exit 0
fi

dest=/usr/local/share/ca-certificates/boks-local-ca.crt

# Decode BEFORE touching the filesystem, so that the two failures stay separate. They were
# not: the decode wrote straight into the temporary file, so a directory this process cannot
# write produced "BOKS_CA_CERT_B64 is not valid base64" — a true statement about the wrong
# thing, printed under the shell's own "cannot create ...: Permission denied". Reported from
# macOS on 2026-08-29, where the sandbox runs as the host's uid and this image's trust store
# was owned by the agent user.
if ! decoded="$(printf '%s' "$BOKS_CA_CERT_B64" | base64 -d 2>/dev/null)"; then
	echo "boks: BOKS_CA_CERT_B64 is not valid base64; the CA was not installed" >&2
	exit 1
fi
case "$decoded" in
*"BEGIN CERTIFICATE"*) ;;
*)
	echo "boks: BOKS_CA_CERT_B64 did not decode to a PEM certificate; the CA was not installed" >&2
	exit 1
	;;
esac

# Write via a temporary file so a truncated write never leaves a half-certificate that
# update-ca-certificates would then splice into the bundle.
tmp="${dest}.tmp.$$"
umask 022
# 2>/dev/null BEFORE the redirection that can fail: redirections are applied left to right,
# so the other order lets the shell's own message through before it is suppressed.
if ! printf '%s\n' "$decoded" 2>/dev/null >"$tmp"; then
	rm -f "$tmp" 2>/dev/null || true
	unwritable "$dest"
	exit 0
fi
mv "$tmp" "$dest"

# Everything update-ca-certificates says on the way to success is chatter, and one line of
# it is a warning it emits on every Debian trixie run ("rehash: warning: skipping
# ca-certificates.crt") that has nothing to do with us. Printing that at the start of every
# sandbox would train people to ignore the output. So: silent when it works, and the whole
# of it when it does not.
if ! output="$(update-ca-certificates 2>&1)"; then
	printf '%s\n' "$output" >&2
	echo "boks: update-ca-certificates failed; the Boks CA is not in this sandbox's system" >&2
	echo "      trust store. Tools that read SSL_CERT_FILE, CURL_CA_BUNDLE," >&2
	echo "      REQUESTS_CA_BUNDLE or NODE_EXTRA_CA_CERTS still trust it." >&2
	exit 0
fi
