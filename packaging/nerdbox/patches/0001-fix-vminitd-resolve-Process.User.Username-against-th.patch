+func TestReadGroupDistinguishesNoMembersFromEmpty(t *testing.T) {
+	root := fstest.MapFS{
+		"etc/group": &fstest.MapFile{Data: []byte(
+			"# a comment\n" +
+				"\n" +
+				"wheel:x:10:\n" +
+				"docker:x:999:node,root\n" +
+				"malformed-too-few-fields\n" +
+				"nonnumeric:x:notagid:node\n")},
+	}
