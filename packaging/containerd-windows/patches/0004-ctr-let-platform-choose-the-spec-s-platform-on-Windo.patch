+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package run
+
+import (
+	"context"
+
+	"github.com/containerd/containerd/v2/core/containers"
+	"github.com/containerd/containerd/v2/pkg/oci"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+)
+
+// withoutWindowsSection removes the spec's `windows` section.
+//
+// It exists for one caller, run_windows.go, and lives in a file with no build constraint
+// only so that it can be tested on a host that is not Windows -- everything it repairs is
+// produced by a Windows host and consumed by a Linux guest, and neither is the machine the
+// tests run on.
+//
+// The section it removes is added by oci.WithDefaultSpecForPlatform: generateDefaultSpecWithPlatform
+// (pkg/oci/spec.go) ends its non-Windows branch with
+//
+//	if err == nil && runtime.GOOS == "windows" {
+//		// To run LCOW we have a Linux and Windows section. Add an empty one now.
+//		s.Windows = &specs.Windows{}
+//	}
+//
+// so *every* Linux spec generated on a Windows host carries one, whatever runtime is going
+// to consume it. `omitempty` does not drop it: specs.Spec.Windows is a pointer, and a
+// non-nil pointer to a zero struct is not empty as far as encoding/json is concerned. What
+// gets marshalled is `"windows":{"layerFolders":null}`, because specs.Windows.LayerFolders
+// carries no omitempty of its own.
+//
+// For LCOW that is correct -- the runhcs shim fills LayerFolders in with the container's
+// layer paths. For any other guest runtime it is fatal. crun parses config.json with
+// libocispec, whose generated parser checks a schema's required fields whenever the object
+// holding them is present, and runtime-spec's schema/config-windows.json makes layerFolders
+// required. So a Linux container created through a Windows host dies at
+//
+//	load `config.json`: Required field 'layerFolders' not present
+//
+// having already booted the guest. The section is removed rather than filled in because a
+// Linux guest has no layer folders; a value invented to satisfy a parser would be a lie the
+// guest then has to ignore.
+//
+// APPLY IT LAST. containerd's own image-config options read `s.Windows != nil` as "this is
+// LCOW, the guest resolves users and groups for itself": oci.WithAdditionalGIDs returns
+// early, and oci.WithUser records the image's user string in Process.User.Username instead
+// of looking it up. Both alternatives mount the image's snapshot on the host, which a
+// Windows host cannot do to a Linux filesystem -- mount_windows.go rejects any mount whose
+// type is not "windows-layer". Removing the section before oci.WithImageConfig has run
+// therefore trades this failure for `invalid windows mount type: erofs`, one step earlier.
+func withoutWindowsSection() oci.SpecOpts {
+	return func(_ context.Context, _ oci.Client, _ *containers.Container, s *specs.Spec) error {
+		s.Windows = nil
+		return nil
+	}
+}
diff --git a/cmd/ctr/commands/run/guestspec_test.go b/cmd/ctr/commands/run/guestspec_test.go
new file mode 100644
index 0000000..a358a2c
--- /dev/null
+++ b/cmd/ctr/commands/run/guestspec_test.go
@@ -0,0 +1,107 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
