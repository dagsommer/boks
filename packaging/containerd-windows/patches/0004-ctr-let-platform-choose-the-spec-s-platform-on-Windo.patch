 		}
 		unpacked, err := image.IsUnpacked(ctx, snapshotter)
 		if err != nil {
@@ -166,6 +235,12 @@ func NewContainer(ctx context.Context, client *containerd.Client, cliContext *cl
 			}
 			opts = append(opts, oci.WithWindowsDevice(idType, devID))
 		}
+
+		// Last, after every option above has had its look at the spec. See
