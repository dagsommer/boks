-		} else {
+
+		// Which platform's spec to generate. Unlike run_unix.go, this used to be
+		// derived solely from the snapshotter name, so the only way to get a Linux
+		// spec on a Windows host was to ask for the windows-lcow snapshotter. Any
+		// other guest-VM runtime -- one backed by an erofs snapshotter, say -- got a
+		// Windows spec for a Linux image and no way to say otherwise, because the
+		// --platform flag this command already advertises was ignored here.
+		//
+		// --platform now selects it, and windows-lcow keeps implying linux/amd64 when
+		// --platform is absent, so no existing invocation changes behaviour.
+		specPlatform := cliContext.String("platform")
+		if specPlatform == "" && snapshotter == "windows-lcow" {
+			specPlatform = "linux/amd64"
+		}
+		var imgPlatform platforms.MatchComparer
+		// Whether the empty `windows` section that oci.WithDefaultSpecForPlatform adds to
+		// every non-Windows spec built on a Windows host has to come back out again. See
+		// withoutWindowsSection: it is there for LCOW, whose runtime fills it in, and it is
+		// fatal to a guest runtime that hands the spec to crun. Decided here, applied at
+		// the very end of this block, because the options in between read it.
+		var dropWindowsSection bool
+		if specPlatform == "" {
 			opts = append(opts, oci.WithDefaultSpec())
 			opts = append(opts, oci.WithWindowNetworksAllowUnqualifiedDNSQuery())
 			opts = append(opts, oci.WithWindowsIgnoreFlushesDuringBoot())
+		} else {
+			p, err := platforms.Parse(specPlatform)
+			if err != nil {
+				return nil, fmt.Errorf("invalid platform %q: %w", specPlatform, err)
+			}
+			// Only constrain image resolution when it was asked for explicitly. The
+			// windows-lcow default above must keep resolving the image the way it
+			// always has.
+			if cliContext.String("platform") != "" {
+				imgPlatform = platforms.Only(p)
+			}
+			opts = append(opts, oci.WithDefaultSpecForPlatform(specPlatform))
+			if p.OS == "windows" {
+				opts = append(opts, oci.WithWindowNetworksAllowUnqualifiedDNSQuery())
+				opts = append(opts, oci.WithWindowsIgnoreFlushesDuringBoot())
+			} else if snapshotter == "windows-lcow" {
+				// LCOW's guest brings its own rootfs; the spec must not name one.
+				opts = append(opts, oci.WithRootFSPath(""))
+			} else {
+				// A non-Windows spec for something that is not LCOW: the only
+				// case where the LCOW section is neither wanted nor tolerated.
+				dropWindowsSection = true
+			}
+		}
+		// Several flags below write into the Windows section and nowhere else, so
+		// dropping that section would discard them without a word. Refuse them
+		// instead: none of them means anything to a non-Windows guest, and a flag
+		// that is accepted and ignored is worse than one that is refused. Only
+		// reachable via an explicit --platform, which nothing could have passed
+		// before, so no existing invocation starts failing.
+		if dropWindowsSection {
+			for _, flag := range []string{"cni", "isolated", "cpu-count", "cpu-shares", "cpu-max", "device"} {
+				if cliContext.IsSet(flag) {
+					return nil, fmt.Errorf("--%s configures a Windows container and has no meaning in a %s spec", flag, specPlatform)
+				}
+			}
 		}
 		if ef := cliContext.String("env-file"); ef != "" {
 			opts = append(opts, oci.WithEnvFile(ef))
@@ -83,9 +138,23 @@ func NewContainer(ctx context.Context, client *containerd.Client, cliContext *cl
 		opts = append(opts, oci.WithEnv(cliContext.StringSlice("env")))
 		opts = append(opts, withMounts(cliContext))
 
