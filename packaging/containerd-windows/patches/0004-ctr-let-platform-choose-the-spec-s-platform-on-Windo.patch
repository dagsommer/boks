+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package run
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/containerd/containerd/v2/core/containers"
+	"github.com/opencontainers/runtime-spec/specs-go"
+)
+
+// linuxSpecFromAWindowsHost is what oci.WithDefaultSpecForPlatform("linux/amd64") produces
+// when runtime.GOOS == "windows": the Linux spec, plus the empty Windows section
+// generateDefaultSpecWithPlatform adds for LCOW. It is built by hand because the condition
+// is the *host's* OS, which no test can choose.
+func linuxSpecFromAWindowsHost() *specs.Spec {
+	return &specs.Spec{
+		Version: specs.Version,
+		Root:    &specs.Root{Path: "rootfs"},
+		Process: &specs.Process{Cwd: "/", Args: []string{"/bin/true"}},
+		Linux:   &specs.Linux{CgroupsPath: "/default/ctr"},
+		Windows: &specs.Windows{},
+	}
+}
+
+// TestAnEmptyWindowsSectionMarshalsAsTheFieldCrunRejects is the reason this option exists,
+// and the reason `omitempty` is not the fix. specs.Spec.Windows is tagged
+// `json:"windows,omitempty"`, but omitempty on a pointer means *nil*, and the section added
+// for LCOW is a non-nil pointer to a zero struct. LayerFolders has no omitempty at all, so
+// what reaches the guest is the exact text crun refused on 2026-08-14.
+func TestAnEmptyWindowsSectionMarshalsAsTheFieldCrunRejects(t *testing.T) {
+	b, err := json.Marshal(linuxSpecFromAWindowsHost())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(b), `"windows":{"layerFolders":null}`) {
+		t.Fatalf("expected the marshalled spec to carry `\"windows\":{\"layerFolders\":null}`, "+
+			"which is what libocispec rejects with `Required field 'layerFolders' not present`; got %s", b)
+	}
+}
+
+func TestWithoutWindowsSectionRemovesIt(t *testing.T) {
+	s := linuxSpecFromAWindowsHost()
+	if err := withoutWindowsSection()(context.Background(), nil, &containers.Container{}, s); err != nil {
+		t.Fatal(err)
+	}
+	if s.Windows != nil {
+		t.Fatalf("the windows section survived: %+v", s.Windows)
+	}
+
+	b, err := json.Marshal(s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), `"windows"`) {
+		t.Fatalf("the marshalled spec still names a windows section: %s", b)
+	}
+
+	// Everything else has to survive: this option's whole job is one field.
+	if s.Linux == nil || s.Linux.CgroupsPath != "/default/ctr" {
+		t.Errorf("the linux section was disturbed: %+v", s.Linux)
+	}
+	if s.Root == nil || s.Root.Path != "rootfs" {
+		t.Errorf("the root section was disturbed: %+v", s.Root)
+	}
+	if s.Process == nil || s.Process.Cwd != "/" {
+		t.Errorf("the process section was disturbed: %+v", s.Process)
+	}
+}
+
+// A spec that never had the section is left exactly as it was -- which is every spec built
+// on a Linux or macOS host, so this is the assertion that the option changes nothing there.
+func TestWithoutWindowsSectionIsANoOpWhenThereIsNoSection(t *testing.T) {
+	s := linuxSpecFromAWindowsHost()
+	s.Windows = nil
+	before, err := json.Marshal(s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := withoutWindowsSection()(context.Background(), nil, &containers.Container{}, s); err != nil {
+		t.Fatal(err)
+	}
+	after, err := json.Marshal(s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(before) != string(after) {
+		t.Fatalf("the spec changed:\n before %s\n after  %s", before, after)
+	}
+}
