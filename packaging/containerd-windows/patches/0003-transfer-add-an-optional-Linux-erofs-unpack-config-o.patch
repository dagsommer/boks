+package transfer
+
+import (
+	"testing"
+
+	"github.com/containerd/platforms"
+)
+
+// A pull of a Linux image through the erofs snapshotter has to find a matching
+// unpack configuration or the transfer service builds an unpacker with no
+// platforms and the pull fails with "no unpack platforms defined".
+func TestDefaultUnpackConfigHasLinuxErofsEntry(t *testing.T) {
+	var found bool
+	for _, uc := range defaultUnpackConfig() {
+		if uc.Snapshotter != "erofs" {
+			continue
+		}
+		found = true
+		p, err := platforms.Parse(uc.Platform)
+		if err != nil {
+			t.Fatalf("erofs unpack platform %q does not parse: %v", uc.Platform, err)
+		}
+		if p.OS != "linux" {
+			t.Errorf("erofs unpack platform is %q, want a linux one", uc.Platform)
+		}
+		if uc.Differ != "erofs" {
+			t.Errorf("erofs unpack config uses differ %q, want erofs", uc.Differ)
+		}
+		// Without Optional, a host that has no mkfs.erofs.exe -- where the
+		// erofs differ returns ErrSkipPlugin -- would fail to start the
+		// transfer plugin at all.
+		if !uc.Optional {
+			t.Error("erofs unpack config must be optional")
+		}
+	}
+	if !found {
+		t.Fatal("no erofs entry in the default unpack configuration")
+	}
+}
