From 4f4bcf028e98f1ac524b66977d4d5a9979849d14 Mon Sep 17 00:00:00 2001
From: Dag Sommer <dagaleks@gmail.com>
Date: Fri, 14 Aug 2026 00:02:43 +0200
Subject: [PATCH 1/2] diff: put the erofs differ in the Windows default order

The erofs differ registers and reports `ok` in `ctr plugins ls`, but the diff
service never asks it anything: on Windows its default order is
["windows", "windows-lcow"], and neither name is erofs. A pull through the
erofs snapshotter therefore reaches the windows differ, which rejects the
erofs snapshotter's mounts with

    number of mounts should always be 1 for Windows layers

and the walk ends there. `ok` in `plugins ls` means "this plugin initialised",
not "this plugin is reachable", which is what made this hard to see.

erofs goes first because it is the only differ in the list that can decline:
for any mount that is not an EROFS-snapshotter layer, MountsToLayer returns
ErrNotImplemented and the loop moves on. The windows and windows-lcow differs
fail hard instead, ending the walk, so erofs anywhere but first is erofs never.

Naming a differ in the order has so far made it mandatory -- a missing one
fails the diff service, which the metadata plugin depends on, which every
service depends on; one skipped snapshotter has been observed taking out about
forty plugins. The erofs differ is explicitly not mandatory: it returns
ErrSkipPlugin when mkfs.erofs is absent from PATH. So a differ that registered
and then skipped itself is now dropped from the order with a warning, while a
name that was never registered at all -- a typo in config.toml -- stays fatal,
and an order left with nothing in it is fatal too.

Signed-off-by: Dag Sommer <dagaleks@gmail.com>
---
 plugins/services/diff/local.go           |  29 ++++-
 plugins/services/diff/local_test.go      | 145 +++++++++++++++++++++++
 plugins/services/diff/service_windows.go |  12 +-
 3 files changed, 182 insertions(+), 4 deletions(-)
 create mode 100644 plugins/services/diff/local_test.go

diff --git a/plugins/services/diff/local.go b/plugins/services/diff/local.go
index 6149f46..58ce17b 100644
--- a/plugins/services/diff/local.go
+++ b/plugins/services/diff/local.go
@@ -23,6 +23,7 @@ import (
 	diffapi "github.com/containerd/containerd/api/services/diff/v1"
 	"github.com/containerd/errdefs"
 	"github.com/containerd/errdefs/pkg/errgrpc"
+	"github.com/containerd/log"
 	"github.com/containerd/plugin"
 	"github.com/containerd/plugin/registry"
 	"github.com/containerd/typeurl/v2"
@@ -70,17 +71,39 @@ func init() {
 			}
 			syncFs := ic.Config.(*config).SyncFs
 			orderedNames := ic.Config.(*config).Order
-			ordered := make([]differ, len(orderedNames))
-			for i, n := range orderedNames {
+			ordered := make([]differ, 0, len(orderedNames))
+			for _, n := range orderedNames {
 				d, ok := differs[n]
 				if !ok {
+					// A differ that registered itself and then returned
+					// ErrSkipPlugin is unavailable on this host by its own
+					// account -- the erofs differ does exactly that when
+					// mkfs.erofs is not on PATH. Dropping it from the order
+					// keeps the diff service working with the rest, instead
+					// of failing init and cascading through the metadata
+					// plugin into every service that depends on it.
+					//
+					// A name that was never registered at all is still a hard
+					// error: that is a typo in the configuration, and silently
+					// ignoring it would leave the daemon running with a diff
+					// order nobody asked for.
+					if p := ic.Plugins().Get(plugins.DiffPlugin, n); p != nil {
+						if err := p.Err(); plugin.IsSkipPlugin(err) {
+							log.G(ic.Context).WithError(err).Warnf("differ %q is registered but unavailable, dropping it from the diff order", n)
+							continue
+						}
+					}
 					return nil, fmt.Errorf("needed differ not loaded: %s", n)
 				}
 
-				ordered[i], ok = d.(differ)
+				od, ok := d.(differ)
 				if !ok {
 					return nil, fmt.Errorf("differ does not implement Comparer and Applier interface: %s", n)
 				}
+				ordered = append(ordered, od)
+			}
+			if len(ordered) == 0 {
+				return nil, fmt.Errorf("no differ from %v is available", orderedNames)
 			}
 
 			return &local{
diff --git a/plugins/services/diff/local_test.go b/plugins/services/diff/local_test.go
new file mode 100644
index 0000000..6395977
--- /dev/null
+++ b/plugins/services/diff/local_test.go
@@ -0,0 +1,145 @@
