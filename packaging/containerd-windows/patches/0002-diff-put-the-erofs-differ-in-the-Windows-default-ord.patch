+
+package diff
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/containerd/plugin"
+	"github.com/containerd/plugin/registry"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+
+	"github.com/containerd/containerd/v2/core/diff"
+	"github.com/containerd/containerd/v2/core/mount"
+	"github.com/containerd/containerd/v2/plugins"
+	"github.com/containerd/containerd/v2/plugins/services"
+)
+
+type testDiffer struct {
+	id string
+}
+
+func (testDiffer) Apply(context.Context, ocispec.Descriptor, []mount.Mount, ...diff.ApplyOpt) (ocispec.Descriptor, error) {
+	return ocispec.Descriptor{}, nil
+}
+
+func (testDiffer) Compare(context.Context, []mount.Mount, []mount.Mount, ...diff.Opt) (ocispec.Descriptor, error) {
+	return ocispec.Descriptor{}, nil
+}
+
+// initDiffService runs the diff service plugin's InitFn against a plugin set
+// built from the given differs, mirroring how the daemon initialises it.
+func initDiffService(t *testing.T, order []string, differs map[string]error) (*local, error) {
+	t.Helper()
+
+	ps := plugin.NewPluginSet()
+	for id, initErr := range differs {
+		reg := &plugin.Registration{
+			Type: plugins.DiffPlugin,
+			ID:   id,
+			InitFn: func(*plugin.InitContext) (any, error) {
+				if initErr != nil {
+					return nil, initErr
+				}
+				return testDiffer{id: id}, nil
+			},
+		}
+		if err := ps.Add(reg.Init(plugin.NewContext(t.Context(), ps, nil))); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	ic := plugin.NewContext(t.Context(), ps, nil)
+	ic.Config = &config{Order: order}
+
+	// Use the registration this package's init() made, so the test exercises
+	// the real InitFn rather than a copy of it.
+	var initFn func(*plugin.InitContext) (any, error)
+	for _, r := range registry.Graph(func(*plugin.Registration) bool { return false }) {
+		if r.Type == plugins.ServicePlugin && r.ID == services.DiffService {
+			initFn = r.InitFn
+		}
+	}
+	if initFn == nil {
+		t.Fatal("diff service plugin is not registered")
+	}
+	inst, err := initFn(ic)
+	if err != nil {
+		return nil, err
+	}
+	return inst.(*local), nil
+}
+
+func TestDiffOrderDropsSkippedDiffer(t *testing.T) {
+	// The erofs differ returns ErrSkipPlugin when mkfs.erofs is not on PATH.
+	// It is in the default order on Windows, and it must not take the whole
+	// diff service -- and with it bolt and every dependent plugin -- down.
+	l, err := initDiffService(t, []string{"erofs", "windows"}, map[string]error{
+		"erofs":   plugin.ErrSkipPlugin,
+		"windows": nil,
+	})
+	if err != nil {
+		t.Fatalf("diff service failed to init with a skipped differ: %v", err)
+	}
+	if len(l.differs) != 1 {
+		t.Fatalf("expected 1 differ, got %d", len(l.differs))
+	}
+	if got := l.differs[0].(testDiffer).id; got != "windows" {
+		t.Fatalf("expected the windows differ to remain, got %q", got)
+	}
+}
+
+func TestDiffOrderKeepsAvailableDiffersInOrder(t *testing.T) {
+	l, err := initDiffService(t, []string{"erofs", "windows"}, map[string]error{
+		"erofs":   nil,
+		"windows": nil,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(l.differs) != 2 {
+		t.Fatalf("expected 2 differs, got %d", len(l.differs))
+	}
+	if got := l.differs[0].(testDiffer).id; got != "erofs" {
+		t.Fatalf("expected erofs first, got %q", got)
+	}
+}
+
+func TestDiffOrderRejectsUnknownDiffer(t *testing.T) {
+	// A name that was never registered is a configuration typo, not an
+	// unavailable plugin, and must still be fatal.
+	_, err := initDiffService(t, []string{"typo"}, map[string]error{"windows": nil})
+	if err == nil || !strings.Contains(err.Error(), "needed differ not loaded") {
+		t.Fatalf("expected a needed-differ-not-loaded error, got %v", err)
+	}
+}
+
+func TestDiffOrderRejectsWhenEveryOrderedDifferSkipped(t *testing.T) {
+	// Dropping skipped differs must not leave an empty order: a diff service
+	// with no differs would accept Apply calls and silently do nothing.
+	// "walking" here is loaded but not in the order, so GetByType succeeds and
+	// the emptiness check is what has to catch this.
+	_, err := initDiffService(t, []string{"erofs"}, map[string]error{
+		"erofs":   plugin.ErrSkipPlugin,
+		"walking": nil,
+	})
+	if err == nil || !strings.Contains(err.Error(), "is available") {
+		t.Fatalf("expected an all-differs-unavailable error, got %v", err)
+	}
+}
diff --git a/plugins/services/diff/service_windows.go b/plugins/services/diff/service_windows.go
index d6f1e5a..f45ac42 100644
--- a/plugins/services/diff/service_windows.go
+++ b/plugins/services/diff/service_windows.go
@@ -16,7 +16,17 @@
 
 package diff
 
+// The erofs differ comes first because it is the only entry that can decline a
+// job: for anything that is not an EROFS-snapshotter layer it returns
+// ErrNotImplemented and the walk continues. The windows and windows-lcow
+// differs do the opposite -- handed the erofs snapshotter's mounts they fail
+// hard with "number of mounts should always be 1 for Windows layers", which
+// ends the walk. So erofs last is the same as erofs absent.
+//
+// Listing a differ here normally makes it mandatory, and the erofs differ is
+// not: it returns ErrSkipPlugin when mkfs.erofs is missing from PATH. See the
+// skip handling in local.go, added in the same series.
 var defaultDifferConfig = &config{
-	Order:  []string{"windows", "windows-lcow"},
+	Order:  []string{"erofs", "windows", "windows-lcow"},
 	SyncFs: false,
 }
