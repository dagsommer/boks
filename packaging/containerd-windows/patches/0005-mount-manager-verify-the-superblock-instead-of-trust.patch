+   limitations under the License.
+*/
+
+package manager
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/containerd/errdefs"
+
+	"github.com/containerd/containerd/v2/core/mount"
+)
+
+const testImageSize = 1 << 20
+
+// newMkfsRoot returns a transformer rooted at a fresh directory, and that
+// directory, mirroring how manager.go builds the rootMap.
+func newMkfsRoot(t *testing.T) (*mkfs, string) {
+	t.Helper()
+	dir := t.TempDir()
+	r, err := os.OpenRoot(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { r.Close() })
+	return &mkfs{rootMap: map[string]*os.Root{dir: r}}, dir
+}
+
+func mkfsMount(dir, name, fs string) mount.Mount {
+	return mount.Mount{
+		Source: filepath.Join(dir, name),
+		Type:   "mkfs/" + fs,
+		Options: []string{
+			prefixMkfs + "fs=" + fs,
+			prefixMkfs + "size=1MiB",
+			"rw",
+		},
+	}
+}
+
+// writeImage creates a file of testImageSize bytes with magic written at off.
+// A nil magic leaves it entirely zero-filled, which is what a failed mkfs
+// leaves behind.
+func writeImage(t *testing.T, path string, off int64, magic string) {
+	t.Helper()
+	f, err := os.Create(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if err := f.Truncate(testImageSize); err != nil {
+		t.Fatal(err)
+	}
+	if magic != "" {
+		if _, err := f.WriteAt([]byte(magic), off); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+// noMkfsBinaries points PATH at an empty directory, so that any mkfs.* the
+// transformer tries to exec is guaranteed absent. That is exactly the
+// condition on Windows, where no mkfs.ext4 exists in any packaged form, and it
+// makes the failure deterministic on a Linux machine that has e2fsprogs.
+func noMkfsBinaries(t *testing.T) {
+	t.Helper()
+	t.Setenv("PATH", t.TempDir())
+}
+
+// A file that carries the filesystem's magic is accepted and left alone. This
+// is the supported "drop in a pre-formatted image" path, and the fix must not
+// break it: on Windows it is the only way a writable layer exists at all.
+func TestMkfsAcceptsFormattedImage(t *testing.T) {
+	for _, tc := range []struct {
+		fs     string
+		offset int64
+		magic  string
+	}{
+		{"ext2", 1080, "\x53\xef"},
+		{"ext3", 1080, "\x53\xef"},
+		{"ext4", 1080, "\x53\xef"},
+		{"xfs", 0, "XFSB"},
+	} {
+		t.Run(tc.fs, func(t *testing.T) {
+			noMkfsBinaries(t)
+			tr, dir := newMkfsRoot(t)
+			m := mkfsMount(dir, "rwlayer.img", tc.fs)
+			writeImage(t, m.Source, tc.offset, tc.magic)
+
+			out, err := tr.Transform(t.Context(), m, nil)
+			if err != nil {
+				t.Fatalf("a formatted %s image was rejected: %v", tc.fs, err)
+			}
+			// The mkfs options are consumed; the rest survives.
+			if len(out.Options) != 1 || out.Options[0] != "rw" {
+				t.Errorf("options = %v, want [rw]", out.Options)
+			}
+			if fi, err := os.Stat(m.Source); err != nil || fi.Size() != testImageSize {
+				t.Errorf("the image was disturbed: %v, %v", fi, err)
+			}
+		})
+	}
+}
+
+// The bug this all exists for. A previous run created the image, truncated it
+// to size, failed to format it and left it behind; the next run saw a file of
+// the right size and handed the guest a zero-filled image presented as ext4.
+func TestMkfsRejectsUnformattedImage(t *testing.T) {
+	noMkfsBinaries(t)
+	tr, dir := newMkfsRoot(t)
+	m := mkfsMount(dir, "rwlayer.img", "ext4")
+	writeImage(t, m.Source, 0, "")
+
+	_, err := tr.Transform(t.Context(), m, nil)
+	if err == nil {
+		t.Fatal("a zero-filled image was accepted as ext4")
+	}
+	if !errdefs.IsFailedPrecondition(err) {
+		t.Errorf("error is %v, want a failed-precondition", err)
+	}
+	if !strings.Contains(err.Error(), "no ext4 superblock") {
+		t.Errorf("error does not say what is wrong: %v", err)
+	}
+	// It is not ours, so it stays exactly where it is.
+	if _, err := os.Stat(m.Source); err != nil {
+		t.Errorf("an image we did not create was removed: %v", err)
+	}
+}
+
+// Near-misses must not pass: the magic has to be the right bytes in the right
+// place, not merely present somewhere.
+func TestMkfsRejectsMisplacedAndTruncatedMagic(t *testing.T) {
+	t.Run("magic at the wrong offset", func(t *testing.T) {
+		noMkfsBinaries(t)
+		tr, dir := newMkfsRoot(t)
+		m := mkfsMount(dir, "rwlayer.img", "ext4")
+		writeImage(t, m.Source, 0, "\x53\xef")
+
+		if _, err := tr.Transform(t.Context(), m, nil); err == nil {
+			t.Fatal("ext4 magic at offset 0 was accepted")
+		}
+	})
+
+	t.Run("byte order reversed", func(t *testing.T) {
+		noMkfsBinaries(t)
+		tr, dir := newMkfsRoot(t)
+		m := mkfsMount(dir, "rwlayer.img", "ext4")
+		// s_magic is a __le16, so 0xEF53 is stored 53 ef, not ef 53.
+		writeImage(t, m.Source, 1080, "\xef\x53")
+
+		if _, err := tr.Transform(t.Context(), m, nil); err == nil {
+			t.Fatal("byte-swapped ext4 magic was accepted")
+		}
+	})
+
+	t.Run("file shorter than the superblock", func(t *testing.T) {
+		noMkfsBinaries(t)
+		tr, dir := newMkfsRoot(t)
+		m := mkfsMount(dir, "rwlayer.img", "ext4")
+		if err := os.WriteFile(m.Source, []byte("short"), 0640); err != nil {
+			t.Fatal(err)
+		}
+
+		if _, err := tr.Transform(t.Context(), m, nil); err == nil {
+			t.Fatal("a five-byte image was accepted as ext4")
+		}
+	})
+}
+
+// A filesystem whose magic is not known cannot be verified, so an existing
+// image for it is refused rather than trusted -- the same refusal the format
+// path gives, which it did not previously get.
+func TestMkfsRejectsExistingImageForUnsupportedFilesystem(t *testing.T) {
+	noMkfsBinaries(t)
+	tr, dir := newMkfsRoot(t)
+	m := mkfsMount(dir, "rwlayer.img", "btrfs")
+	writeImage(t, m.Source, 0, "")
+
+	_, err := tr.Transform(t.Context(), m, nil)
+	if err == nil {
+		t.Fatal("an existing image for an unsupported filesystem was accepted")
+	}
+	if !errdefs.IsInvalidArgument(err) {
+		t.Errorf("error is %v, want an invalid-argument", err)
+	}
+}
+
+// The other half of the fix: a format that fails must not leave the image it
+// created behind, or a retry inherits it. With the superblock check in place a
+// retry would refuse it, but refusing forever is not a working system either --
+// the file has to go so the next attempt can make a real one.
+func TestMkfsRemovesImageItFailedToFormat(t *testing.T) {
+	noMkfsBinaries(t)
+	tr, dir := newMkfsRoot(t)
+	m := mkfsMount(dir, "rwlayer.img", "ext4")
+
+	_, err := tr.Transform(t.Context(), m, nil)
+	if err == nil {
+		t.Fatal("formatting succeeded with no mkfs.ext4 on PATH")
+	}
+	if !strings.Contains(err.Error(), "failed format") {
+		t.Fatalf("failed somewhere other than the format step: %v", err)
+	}
+	if _, err := os.Stat(m.Source); !os.IsNotExist(err) {
+		t.Fatalf("the unformatted image survived a failed format: %v", err)
+	}
+}
+
+// And the two composed, which is the sequence a user actually performs: the
+// run that fails, then the same call again. It must not silently succeed on a
+// file nobody formatted.
+func TestMkfsRetryAfterFailedFormatDoesNotInheritTheImage(t *testing.T) {
+	noMkfsBinaries(t)
+	tr, dir := newMkfsRoot(t)
+	m := mkfsMount(dir, "rwlayer.img", "ext4")
+
+	if _, err := tr.Transform(t.Context(), m, nil); err == nil {
+		t.Fatal("first attempt unexpectedly succeeded")
+	}
+	_, err := tr.Transform(t.Context(), m, nil)
+	if err == nil {
+		t.Fatal("the retry accepted an image that was never formatted")
+	}
+	if !strings.Contains(err.Error(), "failed format") {
+		t.Errorf("the retry did not re-attempt the format: %v", err)
+	}
+}
+
+// The constants above are worth nothing if they do not describe what mkfs
+// actually writes, so check them against it rather than against themselves:
+// format an image for real, then feed the result back in and require it to be
+// recognised. This is the test that would catch a wrong offset or a
+// byte-order slip, which every other test here would happily agree with.
+func TestMkfsRecognisesWhatItJustWrote(t *testing.T) {
+	if _, err := exec.LookPath("mkfs.ext4"); err != nil {
+		t.Skip("mkfs.ext4 is not on PATH")
+	}
+	tr, dir := newMkfsRoot(t)
+	m := mkfsMount(dir, "rwlayer.img", "ext4")
+	// Comfortably above ext4's minimum; 1 MiB is not.
+	m.Options[1] = prefixMkfs + "size=16MiB"
+
+	if _, err := tr.Transform(t.Context(), m, nil); err != nil {
+		t.Fatalf("failed to format: %v", err)
+	}
+	if _, err := tr.Transform(t.Context(), m, nil); err != nil {
+		t.Fatalf("an image mkfs.ext4 just wrote was not recognised as ext4: %v", err)
+	}
+}
+
+// Every filesystem the format path can create must be verifiable, or the gap
+// this closes reopens for whichever one was missed.
+func TestSuperblockProbesCoverEveryCreatableFilesystem(t *testing.T) {
+	have := map[string]bool{}
+	for _, p := range superblockProbes {
+		if p.magic == "" {
+			t.Errorf("probe for %q has an empty magic", p.fs)
+		}
+		have[p.fs] = true
+	}
+	for _, fs := range []string{"ext2", "ext3", "ext4", "xfs"} {
+		if !have[fs] {
+			t.Errorf("no superblock probe for %q, which the format path can create", fs)
+		}
+	}
+}
-- 
