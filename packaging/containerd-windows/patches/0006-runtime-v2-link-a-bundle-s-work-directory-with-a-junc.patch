+
+	"golang.org/x/sys/windows"
+)
+
+// linkWorkDir links a bundle's working directory into the bundle as `work`.
+//
+// A junction first, and a symlink only if that fails.
+//
+// Creating a symlink on Windows requires SeCreateSymbolicLinkPrivilege, which
+// Administrators hold and ordinary users do not. Go already asks for the one
+// concession the platform offers -- os.Symlink passes
+// SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE and retries without it -- but Windows
+// honours that flag only when Developer Mode is on, which is a machine-wide setting
+// that grants unprivileged symlink creation to every process on the machine and is
+// commonly disabled by policy. So an unelevated containerd could not create a task
+// bundle at all: NewBundle failed with ERROR_PRIVILEGE_NOT_HELD before the shim was
+// ever launched.
+//
+// A junction (a directory mount point) is the same thing for this purpose and needs
+// no privilege at all -- `mklink /J` works for an ordinary user, which is the whole
+// reason it is tried first. It is a strictly less capable link: the target must be a
+// fully qualified path on a local volume, so it cannot express a UNC or relative
+// target that a symlink can. That is why this falls back rather than replacing the
+// symlink outright. Every configuration that works today still works; the unelevated
+// one now works too.
+//
+// Both failing is reported as one error naming both causes, because the useful
+// question at that point is which of the two constraints the machine violated. What
+// this never does is succeed without a link: `work` is how Bundle.Delete finds the
+// working directory to remove, and a bundle that quietly had no link would leak that
+// directory on every task, forever, with nothing failing.
+func linkWorkDir(work, link string) error {
+	jerr := createWorkDirJunction(work, link)
+	if jerr == nil {
+		return nil
+	}
+	serr := os.Symlink(work, link)
+	if serr == nil {
+		return nil
+	}
+	return fmt.Errorf("link work directory %s -> %s: as a junction: %w; as a symlink: %w", link, work, jerr, serr)
+}
+
+// createWorkDirJunction makes link a directory junction pointing at target.
+//
+// There is no CreateJunction in Win32 and none in Go: a junction is an empty
+// directory carrying a mount point reparse point, and it is made in two steps.
+// If the second step fails the first is undone, because the failure mode of
+// leaving an ordinary empty directory called `work` behind is the bad one --
+// os.Readlink would then fail on it, Bundle.Delete tolerates a failed Readlink by
+// skipping the working directory, and the leak would be silent.
+//
+// The handle flags are the ones the Go standard library's own directory-junction
+// test uses (os.TestDirectoryJunction): FILE_FLAG_BACKUP_SEMANTICS is required to
+// open a directory at all, and FILE_FLAG_OPEN_REPARSE_POINT is what makes the open
+// address the directory itself rather than follow anything already on it.
+func createWorkDirJunction(target, link string) (err error) {
+	buf, err := encodeMountPointReparseBuffer(target)
+	if err != nil {
+		return err
+	}
+	if err := os.Mkdir(link, 0700); err != nil {
+		return err
+	}
+	defer func() {
+		if err != nil {
+			if rerr := os.Remove(link); rerr != nil {
+				err = fmt.Errorf("%w (and removing the half-made junction failed: %v)", err, rerr)
+			}
+		}
+	}()
+	p, err := windows.UTF16PtrFromString(link)
+	if err != nil {
+		return err
+	}
+	h, err := windows.CreateFile(p, windows.GENERIC_WRITE, 0, nil, windows.OPEN_EXISTING,
+		windows.FILE_FLAG_OPEN_REPARSE_POINT|windows.FILE_FLAG_BACKUP_SEMANTICS, 0)
+	if err != nil {
+		return fmt.Errorf("open %s to set a reparse point: %w", link, err)
+	}
+	defer func() { _ = windows.CloseHandle(h) }()
+	var returned uint32
+	if err := windows.DeviceIoControl(h, windows.FSCTL_SET_REPARSE_POINT,
+		&buf[0], uint32(len(buf)), nil, 0, &returned, nil); err != nil {
+		return fmt.Errorf("set a mount point reparse point on %s: %w", link, err)
+	}
+	return nil
+}
