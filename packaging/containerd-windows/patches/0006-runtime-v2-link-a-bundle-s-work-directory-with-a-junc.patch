+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package v2
+
+// This file has no build constraint on purpose. Everything in it is pure byte
+// manipulation with no system call in it, and it is only ever used by Windows --
+// so the one machine that cannot compile it is the one machine that needs it.
+// Keeping it constraint-free is what lets worklink_test.go check the buffer
+// layout on a Linux builder, where the rest of the Windows path cannot even be
+// compiled, let alone run.
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"unicode/utf16"
+)
+
+const (
+	// ioReparseTagMountPoint is IO_REPARSE_TAG_MOUNT_POINT, the reparse tag of a
+	// directory junction. Not IO_REPARSE_TAG_SYMLINK (0xA000000C): a junction is what
+	// an unprivileged Windows user is allowed to create.
+	ioReparseTagMountPoint = 0xA0000003
+
+	// mountPointHeaderSize is the size of everything in a mount point
+	// REPARSE_DATA_BUFFER before PathBuffer: ReparseTag (4) + ReparseDataLength (2) +
+	// Reserved (2) + SubstituteNameOffset (2) + SubstituteNameLength (2) +
+	// PrintNameOffset (2) + PrintNameLength (2). See [MS-FSCC] 2.1.2.2.
+	mountPointHeaderSize = 16
+
+	// mountPointFixedFieldsSize is how much of that header ReparseDataLength counts:
+	// the four uint16 name fields, and not the tag, length and reserved words that
+	// precede them. Getting this wrong is the classic way FSCTL_SET_REPARSE_POINT
+	// returns ERROR_INVALID_PARAMETER, which is why the test pins it.
+	mountPointFixedFieldsSize = 8
+
+	// maximumReparseDataBufferSize is MAXIMUM_REPARSE_DATA_BUFFER_SIZE. The whole
+	// buffer, header included, has to fit.
+	maximumReparseDataBufferSize = 16 * 1024
+)
+
+// errNotAWindowsLocalPath is returned by encodeMountPointReparseBuffer for a target
+// it cannot express as an NT path. A junction is a strictly less capable link than a
+// symlink -- it needs a fully qualified local target -- so callers are expected to
+// treat this as "cannot use a junction here" and fall back, not as a fatal error.
+var errNotAWindowsLocalPath = errors.New("not a fully qualified Windows local path")
+
+// encodeMountPointReparseBuffer builds the REPARSE_DATA_BUFFER that turns an empty
+// directory into a junction pointing at target, ready to hand to
+// DeviceIoControl(FSCTL_SET_REPARSE_POINT).
+//
+// The layout is [MS-FSCC] 2.1.2.2, and it is the same one go-winio's
+// EncodeReparsePoint writes; it is reproduced here rather than imported because
+// go-winio's copy is behind a windows build constraint and so cannot be tested
+// anywhere it would be worth testing.
+//
+// PathBuffer holds the substitute name (the NT path the filesystem actually follows)
+// and then the print name (the DOS path a user is shown), each NUL-terminated. The
+// NULs are stored but are not counted in either length field -- Windows accepts the
+// counted form without them, but junctions written by mklink /J carry them, and
+// matching what the platform writes is worth more than saving four bytes.
+func encodeMountPointReparseBuffer(target string) ([]byte, error) {
+	// Backslashes, always: NT paths have no notion of '/' as a separator, and a
+	// containerd --root is free to have been configured with one.
+	printName := strings.ReplaceAll(target, "/", `\`)
+	ntName, err := ntPath(printName)
+	if err != nil {
+		return nil, err
+	}
+
+	substitute := utf16.Encode([]rune(ntName + "\x00"))
+	display := utf16.Encode([]rune(printName + "\x00"))
+	total := mountPointHeaderSize + (len(substitute)+len(display))*2
+	if total > maximumReparseDataBufferSize {
+		return nil, fmt.Errorf("reparse point for %q exceeds MAXIMUM_REPARSE_DATA_BUFFER_SIZE", target)
+	}
+
+	buf := make([]byte, total)
+	putUint32LE(buf[0:4], ioReparseTagMountPoint)
+	putUint16LE(buf[4:6], uint16(total-(mountPointHeaderSize-mountPointFixedFieldsSize)))
+	// buf[6:8] is Reserved, and stays zero.
+	putUint16LE(buf[8:10], 0)                              // SubstituteNameOffset
+	putUint16LE(buf[10:12], uint16((len(substitute)-1)*2)) // SubstituteNameLength
+	putUint16LE(buf[12:14], uint16(len(substitute)*2))     // PrintNameOffset
+	putUint16LE(buf[14:16], uint16((len(display)-1)*2))    // PrintNameLength
+	at := mountPointHeaderSize
+	for _, names := range [][]uint16{substitute, display} {
+		for _, u := range names {
+			putUint16LE(buf[at:at+2], u)
+			at += 2
+		}
+	}
+	return buf, nil
+}
+
+// putUint16LE and putUint32LE stand in for encoding/binary, which this package cannot
+// import: core/runtime/v2 already has a type called binary (binary.go), and shadowing
+// it here would break that file rather than this one.
+func putUint16LE(b []byte, v uint16) {
+	b[0], b[1] = byte(v), byte(v>>8)
+}
+
+func putUint32LE(b []byte, v uint32) {
+	b[0], b[1], b[2], b[3] = byte(v), byte(v>>8), byte(v>>16), byte(v>>24)
+}
+
+// ntPath converts a Windows path to the NT form a reparse point's substitute name has
+// to be in. It deliberately refuses everything it is not sure about -- a relative
+// path, a drive-relative path like `C:work`, a device path -- because the caller's
+// answer to "no" is to fall back to a symlink, which is strictly more capable.
+//
+// filepath is not used here, and must not be: this file is compiled and tested on
+// Linux, where filepath.IsAbs("C:\\x") is false and filepath.VolumeName is "".
+func ntPath(path string) (string, error) {
+	if strings.ContainsRune(path, 0) {
+		return "", fmt.Errorf("%q: %w", path, errNotAWindowsLocalPath)
+	}
+	switch {
+	case strings.HasPrefix(path, `\\?\`):
+		// Already an extended-length path; \\?\ and \??\ mean the same thing to the
+		// object manager.
+		return `\??\` + path[4:], nil
+	case strings.HasPrefix(path, `\\`):
+		// A UNC path. Encoded correctly, and expected to be refused by Windows:
+		// junctions cannot leave the local machine. The caller falls back.
+		return `\??\UNC\` + path[2:], nil
+	case len(path) >= 3 && isDriveLetter(path[0]) && path[1] == ':' && path[2] == '\\':
+		return `\??\` + path, nil
+	default:
+		return "", fmt.Errorf("%q: %w", path, errNotAWindowsLocalPath)
+	}
+}
+
+func isDriveLetter(c byte) bool {
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
