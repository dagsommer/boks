diff --git a/core/runtime/v2/worklink.go b/core/runtime/v2/worklink.go
new file mode 100644
index 0000000..8d9964a
--- /dev/null
+++ b/core/runtime/v2/worklink.go
@@ -0,0 +1,150 @@
+/*
