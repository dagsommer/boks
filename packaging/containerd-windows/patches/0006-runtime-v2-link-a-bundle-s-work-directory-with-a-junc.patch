+package v2
+
+import "os"
+
+// linkWorkDir links a bundle's working directory into the bundle as `work`.
+//
+// A symlink, unchanged, and deliberately so: it is the correct link everywhere
+// os.Symlink is not a privileged operation, the runc shim resolves
+// <bundle>/work by walking that path, and Bundle.Delete reads it back with
+// os.Readlink. Only Windows has a reason to do anything else.
+func linkWorkDir(work, link string) error {
+	return os.Symlink(work, link)
+}
diff --git a/core/runtime/v2/worklink_test.go b/core/runtime/v2/worklink_test.go
new file mode 100644
index 0000000..d480547
--- /dev/null
+++ b/core/runtime/v2/worklink_test.go
@@ -0,0 +1,192 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package v2
+
+// No build constraint, matching worklink.go. These tests are about the bytes a
+// Windows daemon hands to FSCTL_SET_REPARSE_POINT, and they are most useful on the
+// machines that cannot run a Windows daemon.
+
+import (
+	binle "encoding/binary"
+	"encoding/hex"
+	"errors"
+	"strings"
+	"testing"
+	"unicode/utf16"
+)
+
+// The mount point REPARSE_DATA_BUFFER for a junction at some path pointing at
+// `C:\w`, written out by hand from [MS-FSCC] 2.1.2.2 rather than captured from the
+// encoder, so that agreeing with it means something:
+//
+//	03 00 00 a0   ReparseTag           IO_REPARSE_TAG_MOUNT_POINT, little-endian
+//	24 00         ReparseDataLength    36 = the whole buffer (44) less the 8 bytes
+//	                                   of tag/length/reserved that precede the count
+//	00 00         Reserved
+//	00 00         SubstituteNameOffset 0, the substitute name comes first
+//	10 00         SubstituteNameLength 16 = len(`\??\C:\w`) * 2, NUL not counted
+//	12 00         PrintNameOffset      18 = past the substitute name AND its NUL
+//	08 00         PrintNameLength      8  = len(`C:\w`) * 2, NUL not counted
+//	5c00 3f00 3f00 5c00 4300 3a00 5c00 7700 0000    `\??\C:\w` + NUL, UTF-16LE
+//	4300 3a00 5c00 7700 0000                        `C:\w`     + NUL, UTF-16LE
+const junctionToCWGolden = "030000a0" + "2400" + "0000" +
+	"0000" + "1000" + "1200" + "0800" +
+	"5c003f003f005c0043003a005c0077000000" +
+	"43003a005c0077000000"
+
+func TestWorkDirJunctionBufferMatchesTheDocumentedLayout(t *testing.T) {
+	got, err := encodeMountPointReparseBuffer(`C:\w`)
+	if err != nil {
+		t.Fatalf("encodeMountPointReparseBuffer: %v", err)
+	}
+	want, err := hex.DecodeString(junctionToCWGolden)
+	if err != nil {
+		t.Fatalf("bad golden: %v", err)
+	}
+	if hex.EncodeToString(got) != hex.EncodeToString(want) {
+		t.Fatalf("reparse buffer mismatch\n got %s\nwant %s", hex.EncodeToString(got), hex.EncodeToString(want))
+	}
+	// Stated separately because it is the field most likely to be wrong and least
+	// likely to be noticed: Windows rejects the whole ioctl with
+	// ERROR_INVALID_PARAMETER if ReparseDataLength does not describe what follows it.
+	if l := binle.LittleEndian.Uint16(got[4:6]); int(l) != len(got)-8 {
+		t.Fatalf("ReparseDataLength = %d, want %d (buffer is %d bytes)", l, len(got)-8, len(got))
+	}
+}
+
+func TestWorkDirJunctionBufferIsAMountPointNotASymlink(t *testing.T) {
+	// The entire point of the patch. A symlink reparse point (0xA000000C) is what
+	// unprivileged Windows refuses to create; a mount point (0xA0000003) is what it
+	// allows. Nothing else in the buffer distinguishes them at a glance, and the two
+	// tags differ in one nibble.
+	const ioReparseTagSymlink = 0xA000000C
+	for _, target := range []string{`C:\w`, `C:\cdtest\root\default\abc123`, `\\?\C:\w`} {
+		buf, err := encodeMountPointReparseBuffer(target)
+		if err != nil {
+			t.Fatalf("encodeMountPointReparseBuffer(%q): %v", target, err)
+		}
+		tag := binle.LittleEndian.Uint32(buf[0:4])
+		if tag == ioReparseTagSymlink {
+			t.Fatalf("encodeMountPointReparseBuffer(%q) wrote IO_REPARSE_TAG_SYMLINK", target)
+		}
+		if tag != ioReparseTagMountPoint {
+			t.Fatalf("encodeMountPointReparseBuffer(%q) tag = %#x, want %#x", target, tag, ioReparseTagMountPoint)
+		}
+		// A mount point buffer has no Flags word. A symlink buffer does, and putting
+		// one here would shift both names by four bytes.
+		if off := binle.LittleEndian.Uint16(buf[8:10]); off != 0 {
+			t.Fatalf("SubstituteNameOffset = %d, want 0 (a mount point has no Flags word)", off)
+		}
+	}
+}
+
+func TestWorkDirJunctionBufferIsWhatReadlinkReadsBack(t *testing.T) {
+	// Bundle.Delete finds the working directory to remove with os.Readlink, and
+	// os.Readlink on Windows reads IO_REPARSE_TAG_MOUNT_POINT by taking the
+	// substitute name and stripping the `\??\` device prefix
+	// (go/src/os/file_windows.go, readReparseLinkHandle and normaliseLinkPath).
+	// If that came back wrong -- or empty -- Delete would silently stop removing
+	// working directories, which leaks disk rather than failing. So decode the way
+	// it does, from the field offsets and not from the encoder's variables.
+	for _, tc := range []struct{ target, want string }{
+		{`C:\w`, `C:\w`},
+		{`C:\cdtest\root\default\abc123`, `C:\cdtest\root\default\abc123`},
+		{`c:\lower\case`, `c:\lower\case`},
+		// A --root configured with forward slashes still has to produce an NT path.
+		{`C:/cdtest/root/default/abc123`, `C:\cdtest\root\default\abc123`},
+		// Extended-length in, plain out: `\\?\` and `\??\` are the same prefix to
+		// the object manager, so Readlink strips it to the same thing.
+		{`\\?\C:\w`, `C:\w`},
+	} {
+		buf, err := encodeMountPointReparseBuffer(tc.target)
+		if err != nil {
+			t.Fatalf("encodeMountPointReparseBuffer(%q): %v", tc.target, err)
+		}
+		got := readlinkFromMountPointBuffer(t, buf)
+		if got != tc.want {
+			t.Errorf("Readlink of a junction to %q would give %q, want %q", tc.target, got, tc.want)
+		}
+	}
+}
+
+func TestWorkDirJunctionRefusesTargetsAJunctionCannotExpress(t *testing.T) {
+	// Refusing is the safe answer: linkWorkDir falls back to os.Symlink, which is
+	// what these paths needed anyway. Accepting them would write a buffer Windows
+	// rejects, or worse, one it accepts and cannot follow.
+	for _, target := range []string{
+		``,
+		`work`,
+		`.\work`,
+		`\work`,
+		`C:work`,     // drive-relative: resolves against the drive's current directory
+		`1:\work`,    // not a drive letter
+		"C:\\w\x00x", // embedded NUL would truncate the counted string
+	} {
+		if _, err := encodeMountPointReparseBuffer(target); !errors.Is(err, errNotAWindowsLocalPath) {
+			t.Errorf("encodeMountPointReparseBuffer(%q) error = %v, want errNotAWindowsLocalPath", target, err)
+		}
+	}
+	// A UNC target encodes -- correctly, as `\??\UNC\...` -- and is left for Windows
+	// to refuse, because a junction cannot leave the local machine. Encoding it
+	// wrongly here would turn a clean fallback into a corrupt reparse point.
+	buf, err := encodeMountPointReparseBuffer(`\\server\share\work`)
+	if err != nil {
+		t.Fatalf("encodeMountPointReparseBuffer of a UNC path: %v", err)
+	}
+	if got := substituteName(buf); got != `\??\UNC\server\share\work` {
+		t.Errorf("UNC substitute name = %q, want %q", got, `\??\UNC\server\share\work`)
+	}
+	// And a target too long for the reparse buffer is refused rather than truncated.
+	if _, err := encodeMountPointReparseBuffer(`C:\` + strings.Repeat("a", 8192)); err == nil {
+		t.Error("a target larger than MAXIMUM_REPARSE_DATA_BUFFER_SIZE was accepted")
+	}
+}
+
+// substituteName reads the substitute name out of a mount point REPARSE_DATA_BUFFER
+// using the offsets from [MS-FSCC] 2.1.2.2 directly, so that a mistake in the encoder
+// cannot be cancelled out by the same mistake here.
+func substituteName(buf []byte) string {
+	off := 16 + int(binle.LittleEndian.Uint16(buf[8:10]))
+	end := off + int(binle.LittleEndian.Uint16(buf[10:12]))
+	u := make([]uint16, 0, (end-off)/2)
+	for i := off; i < end; i += 2 {
+		u = append(u, binle.LittleEndian.Uint16(buf[i:i+2]))
+	}
+	return string(utf16.Decode(u))
+}
+
+// readlinkFromMountPointBuffer is what os.Readlink does with these bytes on Windows.
+func readlinkFromMountPointBuffer(t *testing.T, buf []byte) string {
+	t.Helper()
+	if tag := binle.LittleEndian.Uint32(buf[0:4]); tag != ioReparseTagMountPoint {
+		t.Fatalf("os.Readlink would return ENOENT: tag %#x is neither a symlink nor a mount point", tag)
+	}
+	s := substituteName(buf)
+	// os.normaliseLinkPath: `\??\X:\...` becomes `X:\...`, `\??\UNC\a\b` becomes
+	// `\\a\b`, and anything else is returned as it stands.
+	if !strings.HasPrefix(s, `\??\`) {
+		return s
+	}
+	s = s[4:]
+	switch {
+	case len(s) >= 2 && s[1] == ':':
+		return s
+	case strings.HasPrefix(s, `UNC\`):
+		return `\\` + s[4:]
+	}
+	return s
+}
