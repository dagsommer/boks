From 2f4f91bcdea5270f44d0dbc5f66fdfd680d06f38 Mon Sep 17 00:00:00 2001
From: Dag Sommer <dagaleks@me.com>
Date: Fri, 2 Oct 2026 14:15:04 +0200
Subject: [PATCH] mount/manager: create a writable layer as a sparse file on
 Windows

On NTFS a file is sparse only when flagged so. Unflagged, the truncate
that sizes a writable layer reserves every cluster, and mkfs.ext4's
writes near the end make the host zero-fill everything before them. A
16 GiB layer needed 16 GiB of free space to exist ("There is not enough
space on the disk" at truncate) and about 110 s of disk writes before the
VM could boot.

Flag the file with FSCTL_SET_SPARSE before extending it. A volume that
cannot hold sparse files refuses it; that is logged and the file stays
dense, as before.
---
 core/mount/manager/mkfs.go           |  5 ++++
 core/mount/manager/sparse_other.go   | 24 +++++++++++++++++
 core/mount/manager/sparse_windows.go | 40 ++++++++++++++++++++++++++++
 3 files changed, 69 insertions(+)
 create mode 100644 core/mount/manager/sparse_other.go
 create mode 100644 core/mount/manager/sparse_windows.go

diff --git a/core/mount/manager/mkfs.go b/core/mount/manager/mkfs.go
index 767e4ea..fbeffbc 100644
--- a/core/mount/manager/mkfs.go
+++ b/core/mount/manager/mkfs.go
@@ -231,6 +231,11 @@ func (t *mkfs) Transform(ctx context.Context, m mount.Mount, a []mount.ActiveMou
 
 		createArgs = append(createArgs, f.Name())
 
+		// Sparse before the truncate, or the truncate is an allocation. See sparse_windows.go.
+		if err := makeSparse(f); err != nil {
+			log.G(ctx).WithError(err).WithField("path", m.Source).Warn("writable layer is not sparse; it will occupy its full size on disk")
+		}
+
 		err = f.Truncate(size)
 		f.Close()
 		if err != nil {
diff --git a/core/mount/manager/sparse_other.go b/core/mount/manager/sparse_other.go
new file mode 100644
index 0000000..d610a8c
--- /dev/null
+++ b/core/mount/manager/sparse_other.go
@@ -0,0 +1,24 @@
+//go:build !windows
+
