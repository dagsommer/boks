+/// Maps the whole of `file` read-only into this process and returns the host address of the
+/// mapping, or `None` if the mapping could not be established.
+///
+/// The mapping is deliberately never torn down. Its address is handed to the VMM as a
+/// `KernelBundle`, which the guest reads from for as long as the VM lives.
+#[cfg(all(unix, target_arch = "x86_64", not(feature = "tee")))]
+fn map_file_readonly(file: &File, size: u64) -> Option<*mut c_void> {
+    // Safe because this asks for a fresh mapping of a file we just opened for reading, and the
+    // kernel picks the address.
+    let addr = unsafe {
+        libc::mmap(
+            std::ptr::null_mut(),
+            size as usize,
+            libc::PROT_READ,
+            libc::MAP_SHARED,
+            file.as_raw_fd(),
+            0_i64,
+        )
+    };
+    if std::ptr::eq(addr, libc::MAP_FAILED) {
+        None
+    } else {
+        Some(addr)
+    }
+}
+
+/// See the Unix variant above. A section plus a mapped view is the Windows spelling of the same
+/// read-only, file-backed mapping: passing zero for both the maximum size and the byte count
+/// maps the file in its entirety, and the view is page-aligned because views are handed out at
+/// the (coarser) allocation granularity.
+///
+/// The section handle is closed immediately. A mapped view keeps the section alive by itself,
+/// just as an mmap outlives the descriptor it was made from.
+#[cfg(all(windows, target_arch = "x86_64", not(feature = "tee")))]
+fn map_file_readonly(file: &File, _size: u64) -> Option<*mut c_void> {
+    use std::os::windows::io::AsRawHandle;
+    use windows_sys::Win32::Foundation::CloseHandle;
+    use windows_sys::Win32::System::Memory::{
+        CreateFileMappingW, FILE_MAP_READ, MapViewOfFile, PAGE_READONLY,
+    };
+
+    // Safe because `file` is open for reading and outlives this call.
+    let mapping = unsafe {
+        CreateFileMappingW(
+            file.as_raw_handle(),
+            std::ptr::null(),
+            PAGE_READONLY,
+            0,
+            0,
+            std::ptr::null(),
+        )
+    };
+    if mapping.is_null() {
+        return None;
+    }
+
+    // Safe because `mapping` is the section handle created just above.
+    let view = unsafe { MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, 0) };
+    // Safe because nothing else holds this handle, and the view is unaffected by closing it.
+    unsafe { CloseHandle(mapping) };
+
+    if view.Value.is_null() {
+        None
+    } else {
+        Some(view.Value)
+    }
+}
+
