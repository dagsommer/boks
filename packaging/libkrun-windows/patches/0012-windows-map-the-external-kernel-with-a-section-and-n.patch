-            libc::PROT_READ,
-            libc::MAP_SHARED,
-            file.as_raw_fd(),
-            0_i64,
-        )
-    };
-    if std::ptr::eq(kernel_host_addr, libc::MAP_FAILED) {
-        error!("Can't load kernel into process map");
+    let Some(kernel_host_addr) = map_file_readonly(&file, kernel_size) else {
+        error!(
