     let file = match File::options().read(true).write(false).open(kernel_path) {
@@ -2141,20 +2231,13 @@ fn map_kernel(ctx_id: u32, kernel_path: &PathBuf) -> i32 {
 
     let kernel_size = file.metadata().unwrap().len();
 
-    let kernel_host_addr = unsafe {
