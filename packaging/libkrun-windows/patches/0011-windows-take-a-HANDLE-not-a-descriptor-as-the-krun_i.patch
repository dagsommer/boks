-        let target = match target {
-        ..-1 => return -libc::EINVAL,
+/// Resolves the caller-supplied log target, which is the file descriptor documented in
+/// libkrun.h.
+#[cfg(unix)]
+unsafe fn resolve_log_target(target: RawFd) -> Result<Target, i32> {
+    Ok(match target {
+        ..-1 => return Err(-libc::EINVAL),
         -1 => Target::default(),
-        0 /* stdin */ => return -libc::EINVAL,
+        0 /* stdin */ => return Err(-libc::EINVAL),
         1 /* stdout */ => Target::Stdout,
         2 /* stderr */ => Target::Stderr,
-        fd => Target::Pipe(Box::new(File::from_raw_fd(fd))),
+        fd => Target::Pipe(Box::new(unsafe { File::from_raw_fd(fd) })),
+    })
+}
+
+/// See the Unix variant above. On Windows the target is a HANDLE rather than a descriptor --
+/// the same substitution libkrun.h already makes for the virtio-console entry points -- because
+/// a CRT file descriptor only means anything to the CRT instance that produced it, and krun.dll
+/// does not share one with its caller.
+///
+/// KRUN_LOG_TARGET_DEFAULT needs no special case here: -1 as a handle is INVALID_HANDLE_VALUE,
+/// so the documented sentinel keeps working unchanged.
+#[cfg(windows)]
+unsafe fn resolve_log_target(target: *mut c_void) -> Result<Target, i32> {
+    use std::os::windows::io::FromRawHandle;
+    use windows_sys::Win32::Foundation::{
+        DUPLICATE_SAME_ACCESS, DuplicateHandle, HANDLE, INVALID_HANDLE_VALUE,
+    };
+    use windows_sys::Win32::System::Console::{GetStdHandle, STD_ERROR_HANDLE, STD_OUTPUT_HANDLE};
+    use windows_sys::Win32::System::Threading::GetCurrentProcess;
+
+    let handle: HANDLE = target;
+    if handle == INVALID_HANDLE_VALUE {
+        return Ok(Target::default());
+    }
+    if handle.is_null() {
+        return Err(-libc::EINVAL);
+    }
+
+    // Callers overwhelmingly hand over their own stdout or stderr. Recognising those lets
+    // env_logger write through its own handles, so libkrun never takes on the lifetime of a
+    // handle the caller is still using.
+    if handle == unsafe { GetStdHandle(STD_OUTPUT_HANDLE) } {
+        return Ok(Target::Stdout);
+    }
+    if handle == unsafe { GetStdHandle(STD_ERROR_HANDLE) } {
+        return Ok(Target::Stderr);
+    }
+
+    // Any other handle is written to directly, but duplicate it first: the logger is installed
+    // for the lifetime of the process, and wrapping the caller's handle in a File would make
+    // libkrun responsible for closing something it never owned.
+    let process = unsafe { GetCurrentProcess() };
+    let mut dup: HANDLE = std::ptr::null_mut();
+    // Safe because both handles name this process and `dup` is a valid out-pointer.
+    let ok = unsafe {
+        DuplicateHandle(
+            process,
+            handle,
+            process,
+            &mut dup,
+            0,
+            0,
+            DUPLICATE_SAME_ACCESS,
+        )
     };
+    if ok == 0 {
+        return Err(-libc::EINVAL);
+    }
+    Ok(Target::Pipe(Box::new(unsafe {
+        File::from_raw_handle(dup)
+    })))
+}
+
+/// The log target is a descriptor on Unix and a HANDLE on Windows; see `resolve_log_target`.
+#[cfg(unix)]
+pub type LogTarget = RawFd;
+#[cfg(windows)]
+pub type LogTarget = *mut c_void;
+
+#[allow(clippy::missing_safety_doc)]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn krun_init_log(
+    target: LogTarget,
+    level: u32,
+    style: u32,
+    options: u32,
+) -> i32 {
+    unsafe {
+        let target = match resolve_log_target(target) {
+            Ok(target) => target,
+            Err(err) => return err,
+        };
 
         let filter = log_level_to_filter_str(level);
 
