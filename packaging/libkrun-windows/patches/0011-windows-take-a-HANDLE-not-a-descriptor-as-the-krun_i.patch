From 767eb801fe3fc8b7673c31499eaea3c2e2ae4f5f Mon Sep 17 00:00:00 2001
From: Dag Sommer <dagaleks@gmail.com>
Date: Thu, 13 Aug 2026 14:39:07 +0200
Subject: [PATCH 11/32] windows: take a HANDLE, not a descriptor, as the
 krun_init_log target

A CRT file descriptor is private to the CRT instance that created it, and
krun.dll shares no CRT with the process that loads it, so an int target_fd
crossing that boundary names nothing. libkrun.h already makes exactly this
substitution for the virtio-console entry points, where Windows callers pass
void *handle in place of int fd; krun_init_log now follows suit.

The documented sentinel survives the change for free: KRUN_LOG_TARGET_DEFAULT
is -1, which as a handle is INVALID_HANDLE_VALUE.

Targets equal to the process stdout or stderr resolve to env_logger's own
Target::Stdout/Stderr rather than being wrapped, which is both the common case
and the one where wrapping would be wrong. Any other handle is duplicated
before it is wrapped in a File, because the logger is installed for the life
of the process and must not close a handle the caller still owns.

The fd/handle match moves into resolve_log_target() so the two platforms differ
only in how the target is interpreted, not in how logging is configured.
---
 include/libkrun.h      | 19 +++++++--
 src/libkrun/Cargo.toml |  2 +
 src/libkrun/src/lib.rs | 96 ++++++++++++++++++++++++++++++++++++++----
 3 files changed, 105 insertions(+), 12 deletions(-)

diff --git a/include/libkrun.h b/include/libkrun.h
index 1d66da7..aa40cdf 100644
--- a/include/libkrun.h
+++ b/include/libkrun.h
@@ -37,9 +37,14 @@ typedef uint32_t gid_t;
  * Initializes logging for the library.
  *
  * Arguments:
- *  "target_fd" - File descriptor to write log to. Note that using a file descriptor pointing to a regular file on
- *                filesystem might slow down the VM.
- *                Use KRUN_LOG_TARGET_DEFAULT to use the default target for log output (stderr).
+ *  "target_fd"     - File descriptor to write log to (Unix). Note that using a file descriptor pointing to a
+ *                    regular file on filesystem might slow down the VM.
+ *                    Use KRUN_LOG_TARGET_DEFAULT to use the default target for log output (stderr).
+ *  "target_handle" - HANDLE to write log to (Windows). A CRT file descriptor is only meaningful to the CRT
+ *                    instance that created it, which krun.dll does not share with its caller, so the target is
+ *                    a handle here. KRUN_LOG_TARGET_DEFAULT is still accepted: as a handle it is
+ *                    INVALID_HANDLE_VALUE. Handles other than the process stdout/stderr are duplicated, so the
+ *                    caller keeps ownership of the one it passes in.
  *
  *  "level"     - Level is an integer specifying the level of verbosity, higher number means more verbose log.
  *                The log levels are described by the constants: KRUN_LOG_LEVEL_{OFF, ERROR, WARN, INFO, DEBUG, TRACE}
@@ -53,7 +58,13 @@ typedef uint32_t gid_t;
  * Returns:
  *  Zero on success or a negative error number on failure.
  */
-int32_t krun_init_log(int target_fd, uint32_t level, uint32_t style, uint32_t options);
+int32_t krun_init_log(
+#ifdef _WIN32
+                      void *target_handle,
+#else
+                      int target_fd,
+#endif
+                      uint32_t level, uint32_t style, uint32_t options);
 
