+/// The listening half of a guest-IPC port (`krun_add_vsock_port2(.., listen=true)`).
+pub struct WinsockUnixAcceptorProxy {
+    id: u64,
+    sock: EventSocket,
+    peer_port: u32,
+}
+
+impl WinsockUnixAcceptorProxy {
+    pub fn new(id: u64, path: &PathBuf, peer_port: u32) -> Result<Self, ProxyError> {
+        let sock = EventSocket::create()?;
+        let (addr, addr_len) = sockaddr_un(path)?;
+
+        if unsafe {
+            bind(
+                sock.sock,
+                &addr as *const SOCKADDR_UN as *const SOCKADDR,
+                addr_len,
+            )
+        } == SOCKET_ERROR
+        {
+            return Err(wsa_io_error("bind(AF_UNIX)"));
+        }
+
+        if unsafe { listen(sock.sock, SOMAXCONN as i32) } == SOCKET_ERROR {
+            return Err(wsa_io_error("listen(AF_UNIX)"));
+        }
+
+        Ok(WinsockUnixAcceptorProxy {
+            id,
+            sock,
+            peer_port,
+        })
+    }
+}
+
+impl Proxy for WinsockUnixAcceptorProxy {
+    fn id(&self) -> u64 {
+        self.id
+    }
+    fn status(&self) -> ProxyStatus {
+        ProxyStatus::WaitingOnAccept
+    }
+    fn connect(&mut self, _: &VsockPacket, _: TsiConnectReq) -> ProxyUpdate {
+        unreachable!("a listening IPC port is never asked to connect")
+    }
+    fn sendmsg(&mut self, _: &VsockPacket) -> ProxyUpdate {
+        unreachable!("a listening IPC port carries no data")
+    }
+    fn update_peer_credit(&mut self, _: &VsockPacket) -> ProxyUpdate {
+        unreachable!("a listening IPC port has no peer credit")
+    }
+    fn process_op_response(&mut self, _: &VsockPacket) -> ProxyUpdate {
+        unreachable!("a listening IPC port never issues an OP_REQUEST")
+    }
+    fn release(&mut self) -> ProxyUpdate {
+        unreachable!("a listening IPC port lives as long as the device")
+    }
+
+    fn process_event(&mut self, _evset: EventSet) -> ProxyUpdate {
+        let mut update = ProxyUpdate::default();
+        let (evset, _) = self.sock.take_events();
+
+        if evset.contains(EventSet::HANG_UP) {
+            debug!("process_event: HANG_UP");
+            update.polling = Some((self.id, self.sock.poll_handle(), EventSet::empty()));
+            update.signal_queue = true;
+            update.remove_proxy = ProxyRemoval::Deferred;
+            return update;
+        }
+
+        if evset.contains(EventSet::IN) {
+            let accepted =
+                unsafe { accept(self.sock.sock, std::ptr::null_mut(), std::ptr::null_mut()) };
+            if accepted == INVALID_SOCKET {
+                let err = last_wsa_error();
+                if err != WSAEWOULDBLOCK {
+                    warn!("error accepting connection: id={}, err={err}", self.id);
+                }
+            } else {
+                // The accepted socket travels to `MuxerThread` through
+                // `ProxyUpdate`, whose Windows payload is an `OwnedHandle`.
+                // A SOCKET is a kernel handle value, so this round-trip is
+                // representable; `new_reverse` unwraps it with `into_raw_handle`
+                // rather than letting `OwnedHandle::drop` call `CloseHandle`.
+                //
+                // SAFETY: `accepted` is a freshly returned, exclusively owned
+                // socket handle, and ownership moves into the OwnedHandle here.
+                let handle = unsafe { OwnedHandle::from_raw_handle(accepted as *mut c_void) };
+                update.new_proxy = Some((self.peer_port, handle, NewProxyType::AfUnix));
+            }
+            update.signal_queue = true;
+        }
+
+        // FD_ACCEPT is edge-triggered like every other selected event, so the
+        // listener must be re-armed after each enumerate.
+        if update.polling.is_none() {
+            update.polling = Some((
+                self.id,
+                self.sock.poll_handle(),
+                EventSet::IN | EventSet::EDGE_TRIGGERED,
+            ));
+        }
+
+        update
+    }
+}
+
+impl AsRawFd for WinsockUnixAcceptorProxy {
+    fn as_raw_fd(&self) -> RawFd {
+        self.sock.poll_handle()
+    }
+}
