+/// Builds the single port of a console configured by `krun_set_console_output()`.
+///
+/// The port is a *console* port -- it carries terminal properties, so the guest
+/// marks it VIRTIO_CONSOLE_CONSOLE_PORT and exposes it as `hvcN`, which is what
+/// a `console=hvc0` command line needs. The size is fixed at 0x0 because the
+/// sink is a file or a pipe, not a terminal. Input is empty: the caller asked
+/// for an output sink.
+///
+/// This deliberately does not go through `autoconfigure_console_ports()`: that
+/// one sends console output to the VMM log whenever the output is not a tty,
+/// which is exactly what a caller passing an explicit path does not want.
+#[cfg(unix)]
+fn create_output_only_console_port(
+    cfg: &ConsoleOutputConfig,
+) -> std::result::Result<Vec<PortDescription>, StartMicrovmError> {
+    let to_err =
+        |e: nix::Error| StartMicrovmError::OpenConsoleFile(io::Error::from_raw_os_error(e as i32));
+
+    let output = port_io::output_to_raw_fd_dup(cfg.output_fd).map_err(to_err)?;
+    let input = port_io::input_empty().map_err(to_err)?;
+
+    Ok(vec![PortDescription::console(
+        Some(input),
+        Some(output),
+        port_io::term_fixed_size(0, 0),
+    )])
+}
+
+#[cfg(target_os = "windows")]
+fn create_output_only_console_port(
+    cfg: &ConsoleOutputConfig,
+) -> std::result::Result<Vec<PortDescription>, StartMicrovmError> {
+    let output = if cfg.named_pipe_server {
+        // SAFETY: krun_set_console_output() created this overlapped named pipe
+        // instance and handed its only handle to the configuration; building
+        // the microVM consumes the configuration exactly once.
+        unsafe {
+            port_io::output_to_named_pipe_server(cfg.output_handle.as_raw_handle(), &cfg.name)
+        }
+    } else {
+        port_io::output_to_handle_dup(cfg.output_handle.as_raw_handle())
+    }
+    .map_err(StartMicrovmError::OpenConsoleFile)?;
+
+    let input = port_io::input_empty().map_err(StartMicrovmError::OpenConsoleFile)?;
+
+    Ok(vec![PortDescription::console(
+        Some(input),
+        Some(output),
+        port_io::term_fixed_size(0, 0),
+    )])
+}
