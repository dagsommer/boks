+/// Console output written to the *server* end of a Windows named pipe.
+///
+/// # Why this differs from the Unix file-based console output
+///
+/// On Unix, `krun_set_console_output()` is handed a path that the consumer has
+/// already created and already opened for reading (containerd's nerdbox shim
+/// calls `fifo.OpenFifo(..., O_RDONLY|O_CREAT)` before it calls into libkrun),
+/// so libkrun only has to `open()` it for writing.
+///
+/// On Windows there is no filesystem object to share: the consumer calls
+/// `winio.DialPipe()`, i.e. it is the pipe *client*. libkrun therefore owns the
+/// *server* end -- it creates the pipe in `krun_set_console_output()` (early,
+/// so the client's dial finds it) and must run `ConnectNamedPipe()` before the
+/// first write, because writing to an unconnected pipe instance fails with
+/// ERROR_PIPE_LISTENING.
+///
+/// The connect cannot happen in `krun_set_console_output()` itself: the
+/// consumer only starts dialing *after* that call returns, so a blocking
+/// connect there would deadlock. It happens instead on the first write, from
+/// the port's tx thread, bounded by [`Self::CONNECT_TIMEOUT_MS`].
+///
+/// If no client shows up within that window, or if the client goes away later,
+/// output is *not* discarded and the tx thread is *not* stopped -- either would
+/// turn into an unexplained hang, because a tx thread that stops draining the
+/// virtqueue blocks the guest's console writes forever. Instead the sink is
+/// swapped for the same log sink an unredirected console uses, after one
+/// error-level message naming the pipe and the failure.
+struct PortOutputNamedPipe {
+    /// Kept so that a failure can say which pipe went wrong.
+    name: String,
+    pipe: OwnedHandle,
+    /// Event used by every overlapped operation on `pipe`. Only the tx thread
+    /// touches it, and only one operation is ever in flight.
+    event: OwnedHandle,
+    state: PipeState,
+}
+
+enum PipeState {
+    /// Created, no client connected yet.
+    Listening,
+    Connected,
+    /// The pipe is unusable; console output goes to the VMM log instead.
+    Detached(Box<dyn PortOutput + Send>),
+}
+
+/// Wraps the server end of a named pipe as a console output sink.
+///
+/// # Safety
+///
+/// `handle` must be a valid handle to a named pipe instance created with
+/// FILE_FLAG_OVERLAPPED, and ownership of it transfers to the returned sink,
+/// which closes it on drop.
+pub unsafe fn output_to_named_pipe_server(
+    handle: *mut core::ffi::c_void,
+    name: &str,
+) -> Result<Box<dyn PortOutput + Send>, io::Error> {
+    // Manual-reset, initially unsignaled, unnamed: the standard event for
+    // overlapped I/O where the caller waits for the result itself.
+    let event = unsafe {
+        CreateEventW(
+            std::ptr::null::<SECURITY_ATTRIBUTES>(),
+            TRUE,
+            FALSE,
+            std::ptr::null(),
+        )
+    };
+    if event.is_null() {
+        return Err(io::Error::last_os_error());
+    }
+
+    Ok(Box::new(PortOutputNamedPipe {
+        name: name.to_string(),
+        pipe: unsafe { OwnedHandle::from_raw_handle(handle) },
+        event: unsafe { OwnedHandle::from_raw_handle(event) },
+        state: PipeState::Listening,
+    }))
+}
+
+impl PortOutputNamedPipe {
+    /// How long the first console write waits for a client to connect. The
+    /// consumer starts dialing as soon as `krun_set_console_output()` returns,
+    /// which is long before the guest produces its first console byte, so this
+    /// only ever elapses when nothing is listening at all.
+    const CONNECT_TIMEOUT_MS: u32 = 10_000;
+
+    fn overlapped(&self) -> OVERLAPPED {
+        let mut ov = OVERLAPPED::default();
+        ov.hEvent = self.event.as_raw_handle();
+        ov
+    }
+
+    fn connect(&mut self) -> io::Result<()> {
+        let mut ov = self.overlapped();
+        if unsafe { ConnectNamedPipe(self.pipe.as_raw_handle(), &mut ov) } != 0 {
+            // Documented to always return FALSE for an overlapped pipe, but a
+            // TRUE here still means "connected".
+            return Ok(());
+        }
+
+        let err = io::Error::last_os_error();
+        match err.raw_os_error().map(|e| e as u32) {
+            // The client got here before we did. Not an error.
+            Some(ERROR_PIPE_CONNECTED) => Ok(()),
+            Some(ERROR_IO_PENDING) => {
+                let mut transferred = 0u32;
+                let ok = unsafe {
+                    GetOverlappedResultEx(
+                        self.pipe.as_raw_handle(),
+                        &ov,
+                        &mut transferred,
+                        Self::CONNECT_TIMEOUT_MS,
+                        FALSE,
+                    )
+                };
+                if ok != 0 {
+                    return Ok(());
+                }
+                let err = io::Error::last_os_error();
+                // The OVERLAPPED lives on this stack frame, so the pending
+                // connect has to be cancelled *and waited for* before we
+                // return, or the kernel would write into freed memory.
+                unsafe { CancelIo(self.pipe.as_raw_handle()) };
+                unsafe {
+                    GetOverlappedResult(self.pipe.as_raw_handle(), &ov, &mut transferred, TRUE)
+                };
+                Err(err)
+            }
+            _ => Err(err),
+        }
+    }
+
+    fn write_overlapped(&mut self, buf: &VolatileSlice) -> io::Result<usize> {
+        let len = u32::try_from(buf.len()).map_err(|_| {
+            io::Error::new(ErrorKind::InvalidInput, "buffer length exceeds u32::MAX")
+        })?;
+        let mut ov = self.overlapped();
+        let ret = unsafe {
+            WriteFile(
+                self.pipe.as_raw_handle(),
+                buf.ptr_guard().as_ptr(),
+                len,
+                std::ptr::null_mut(),
+                &mut ov,
+            )
+        };
+        if ret == 0 {
+            let err = io::Error::last_os_error();
+            if err.raw_os_error().map(|e| e as u32) != Some(ERROR_IO_PENDING) {
+                return Err(err);
+            }
+        }
+
+        // Covers both the synchronous and the pending completion; the write is
+        // issued from the port's own tx thread, which is allowed to block.
+        let mut written = 0u32;
+        if unsafe { GetOverlappedResult(self.pipe.as_raw_handle(), &ov, &mut written, TRUE) } == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(written as usize)
+    }
+
+    /// Give up on the pipe and keep the guest's console output in the VMM log.
+    fn detach(&mut self, reason: &io::Error) {
+        log::error!(
+            "guest console: named pipe {name} is unusable ({reason}). Nothing is connected to it: \
+             libkrun serves this pipe and the process that asked for it \
+             (krun_set_console_output) was expected to connect as a client. Guest console output \
+             is not lost -- it continues below, in the VMM log -- but nothing will arrive on the \
+             pipe.",
+            name = self.name,
+        );
+        self.state = PipeState::Detached(output_to_log_as_err());
+    }
+}
+
+impl PortOutput for PortOutputNamedPipe {
+    fn write_volatile(&mut self, buf: &VolatileSlice) -> io::Result<usize> {
+        if matches!(self.state, PipeState::Listening) {
+            match self.connect() {
+                Ok(()) => self.state = PipeState::Connected,
+                Err(e) => self.detach(&e),
+            }
+        }
+
+        if let PipeState::Detached(sink) = &mut self.state {
+            return sink.write_volatile(buf);
+        }
+
+        match self.write_overlapped(buf) {
+            Ok(n) => Ok(n),
+            Err(e) => {
+                // A disconnected client must not stop the tx thread: process_tx
+                // returns on BrokenPipe, and a tx thread that stops draining the
+                // virtqueue wedges the guest's console writes. Fall back to the
+                // log instead, and report the write as consumed.
+                if matches!(
+                    e.raw_os_error().map(|e| e as u32),
+                    Some(ERROR_BROKEN_PIPE | ERROR_NO_DATA | ERROR_PIPE_NOT_CONNECTED)
+                ) {
+                    self.detach(&e);
+                    if let PipeState::Detached(sink) = &mut self.state {
+                        return sink.write_volatile(buf);
+                    }
+                }
+                Err(e)
+            }
+        }
+    }
+
+    fn wait_until_writable(&self) {
+        // Overlapped writes are waited on inline in `write_overlapped`, so
+        // `write_volatile` never reports WouldBlock and process_tx never calls
+        // this. Same contract as PortOutputHandle.
+    }
+}
+
 struct PortInputHandle(OwnedHandle);
 
 impl AsRawHandle for PortInputHandle {
