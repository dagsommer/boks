+/// Opens the sink named by `krun_set_console_output()`.
+///
+/// On Unix the argument is a filesystem path, and the consumer owns whatever
+/// lives there: containerd's nerdbox shim creates the FIFO and opens its read
+/// end before calling in, so all libkrun does is open the write end. O_NONBLOCK
+/// is what keeps that honest -- opening a FIFO for writing with no reader
+/// blocks forever otherwise, and this call happens on the caller's thread. With
+/// it, the "nobody is listening" case fails immediately with ENXIO instead of
+/// hanging the caller.
+#[cfg(all(unix, not(feature = "aws-nitro")))]
+fn open_console_sink(path: &str) -> Result<ConsoleOutputConfig, i32> {
+    use std::os::fd::IntoRawFd;
+    use std::os::unix::fs::OpenOptionsExt;
+
+    let file = std::fs::OpenOptions::new()
+        .write(true)
+        .append(true)
+        .create(true)
+        .mode(0o644)
+        .custom_flags(libc::O_NONBLOCK)
+        .open(path)
+        .map_err(|e| {
+            error!("Could not open console output {path}: {e}");
+            -e.raw_os_error().unwrap_or(libc::EIO)
+        })?;
+
+    Ok(ConsoleOutputConfig {
+        output_fd: file.into_raw_fd(),
+    })
+}
+
+/// True for the `\\.\pipe\...` names Windows uses for named pipes.
+///
+/// Only the local-machine form is recognised: `CreateNamedPipeW` cannot create
+/// a pipe on another host, so a `\\server\pipe\...` name could never be served
+/// from here.
+#[cfg(all(target_os = "windows", not(feature = "aws-nitro")))]
+fn is_local_named_pipe_path(path: &str) -> bool {
+    let prefix = r"\\.\pipe\".as_bytes();
+    let path = path.as_bytes();
+    // Compared as bytes, not as a &str slice: the prefix is ASCII but the name
+    // after it need not be, and slicing a &str at a fixed byte offset panics if
+    // that offset lands inside a multi-byte character. This is reachable from
+    // an FFI caller, so it must not panic.
+    path.len() > prefix.len() && path[..prefix.len()].eq_ignore_ascii_case(prefix)
+}
+
+/// Opens the sink named by `krun_set_console_output()`.
+///
+/// DIFFERENT FROM UNIX BY DESIGN. On Windows the argument is normally a named
+/// pipe name, not a filesystem path, and the two ends are the other way round:
+/// containerd's nerdbox shim (`internal/vm/libkrun/console_windows.go`) builds
+/// a name like `\\.\pipe\krun-console-<pid>-<n>`, hands it to this function and
+/// then *dials* it with `winio.DialPipe()`. It is the client; libkrun has to be
+/// the server. So this creates the pipe instance rather than opening one, and
+/// it does so here, in the configuration call, so that the name exists before
+/// the consumer's first dial (it retries for about five seconds, but there is
+/// no reason to make it wait).
+///
+/// The pipe is created duplex because `winio.DialPipe()` opens with
+/// GENERIC_READ|GENERIC_WRITE; an outbound-only pipe would refuse that client
+/// with ERROR_ACCESS_DENIED. Nothing reads the guest's console input from it --
+/// the port is output-only -- the write access is just what the client asks for.
+///
+/// FILE_FLAG_OVERLAPPED is required by `port_io::output_to_named_pipe_server()`,
+/// which needs a bounded wait for the client to connect.
+///
+/// Any other string is treated as a filesystem path, which matches the Unix
+/// behaviour and the header's wording.
+#[cfg(all(target_os = "windows", not(feature = "aws-nitro")))]
+fn open_console_sink(path: &str) -> Result<ConsoleOutputConfig, i32> {
+    use std::ffi::OsStr;
+    use std::os::windows::ffi::OsStrExt;
+    use std::os::windows::io::IntoRawHandle;
+    use windows_sys::Win32::Foundation::INVALID_HANDLE_VALUE;
+    use windows_sys::Win32::Security::SECURITY_ATTRIBUTES;
+    use windows_sys::Win32::Storage::FileSystem::{FILE_FLAG_OVERLAPPED, PIPE_ACCESS_DUPLEX};
+    use windows_sys::Win32::System::Pipes::{
+        CreateNamedPipeW, PIPE_READMODE_BYTE, PIPE_TYPE_BYTE, PIPE_WAIT,
+    };
+
+    const PIPE_BUFFER_BYTES: u32 = 64 * 1024;
+
+    if is_local_named_pipe_path(path) {
+        let wide: Vec<u16> = OsStr::new(path)
+            .encode_wide()
+            .chain(std::iter::once(0))
+            .collect();
+
+        // SAFETY: `wide` is a NUL-terminated UTF-16 string that outlives the call.
+        let handle = unsafe {
+            CreateNamedPipeW(
+                wide.as_ptr(),
+                PIPE_ACCESS_DUPLEX | FILE_FLAG_OVERLAPPED,
+                PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT,
+                // One console, one consumer. A second instance would let a
+                // second client attach and silently split the output stream.
+                1,
+                PIPE_BUFFER_BYTES,
+                PIPE_BUFFER_BYTES,
+                // Only consulted by clients that call WaitNamedPipe(), which
+                // the consumer does not.
+                0,
+                std::ptr::null::<SECURITY_ATTRIBUTES>(),
+            )
+        };
+        if handle == INVALID_HANDLE_VALUE || handle.is_null() {
+            error!(
+                "Could not create console named pipe {path}: {}",
+                std::io::Error::last_os_error()
+            );
+            return Err(-libc::EIO);
+        }
+
+        return Ok(ConsoleOutputConfig {
+            output_handle: SendHandle::new(handle),
+            named_pipe_server: true,
+            name: path.to_string(),
+        });
+    }
+
+    let file = std::fs::OpenOptions::new()
+        .write(true)
+        .append(true)
+        .create(true)
+        .open(path)
+        .map_err(|e| {
+            error!("Could not open console output {path}: {e}");
+            -e.raw_os_error().unwrap_or(libc::EIO)
+        })?;
+
+    Ok(ConsoleOutputConfig {
+        output_handle: SendHandle::new(file.into_raw_handle()),
+        named_pipe_server: false,
+        name: path.to_string(),
+    })
+}
+
+/// Sends the guest's console to `c_filepath`.
+///
+/// This attaches a virtio-console device with a single console port, so the
+/// guest sees it as `hvcN` and a `console=hvc0` command line works. The number
+/// follows the order consoles are added in, so call this before any
+/// `krun_add_virtio_console_*()` if the redirected console is to be `hvc0`.
+///
+/// See `open_console_sink()` for what `c_filepath` means per platform -- on
+/// Windows it is normally a named pipe name, and libkrun serves that pipe.
+#[allow(clippy::missing_safety_doc)]
+#[unsafe(no_mangle)]
+#[cfg(not(feature = "aws-nitro"))]
+pub unsafe extern "C" fn krun_set_console_output(ctx_id: u32, c_filepath: *const c_char) -> i32 {
+    unsafe {
+        if c_filepath.is_null() {
+            return -libc::EINVAL;
+        }
+        let filepath = match CStr::from_ptr(c_filepath).to_str() {
+            Ok(f) => f,
+            Err(_) => return -libc::EINVAL,
+        };
+
+        match CTX_MAP.lock().unwrap().entry(ctx_id) {
+            Entry::Occupied(mut ctx_cfg) => {
+                let cfg = ctx_cfg.get_mut();
+                if cfg
+                    .vmr
+                    .virtio_consoles
+                    .iter()
+                    .any(|c| matches!(c, VirtioConsoleConfigMode::Output(_)))
+                {
+                    error!("console output has already been configured for this context");
+                    return -libc::EINVAL;
+                }
+
+                let sink = match open_console_sink(filepath) {
+                    Ok(sink) => sink,
+                    Err(err) => return err,
+                };
+                cfg.vmr
+                    .virtio_consoles
+                    .push(VirtioConsoleConfigMode::Output(sink));
+                KRUN_SUCCESS
+            }
+            Entry::Vacant(_) => -libc::ENOENT,
+        }
+    }
+}
