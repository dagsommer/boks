+/// Creates the WHP partition and maps guest memory into it.
+///
+/// Takes the vCPU count, which the KVM and HVF equivalents do not need: `WHvSetupPartition`
+/// finalizes the partition and locks its processor count in, and virtual processors can neither
+/// be created before that call nor added after it.
+#[cfg(target_os = "windows")]
+pub(crate) fn setup_vm(
+    guest_memory: &GuestMemoryMmap,
+    vcpu_count: u8,
+) -> std::result::Result<Vm, StartMicrovmError> {
+    let mut vm = Vm::new(vcpu_count)
+        .map_err(Error::Vm)
+        .map_err(StartMicrovmError::Internal)?;
+    vm.memory_init(guest_memory)
+        .map_err(Error::Vm)
+        .map_err(StartMicrovmError::Internal)?;
+    Ok(vm)
+}
