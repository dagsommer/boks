+/// x86_64 legacy devices on WHP.
+///
+/// The KVM version binds each legacy device's eventfd to a guest IRQ line with `KVM_IRQFD`, so
+/// that writing the fd from a device thread raises the interrupt without the VMM being involved.
+/// WHP has no irqfd, so there is nothing to register here.
+///
+/// KNOWN GAP: that also means nothing currently carries a COM port's `interrupt_evt` to the
+/// IOAPIC. Serial *output* is unaffected (it is a port write the vCPU dispatches synchronously),
+/// and so is `earlycon`; serial *input* will not interrupt the guest until the x86_64 `Serial`
+/// model grows the `set_intc`/`set_irq_line` pair its aarch64 counterpart already has. Boks
+/// drives its console over virtio-console, which raises interrupts through the `IrqChip` and is
+/// unaffected.
+#[cfg(all(target_arch = "x86_64", target_os = "windows"))]
+fn attach_legacy_devices(
+    pio_device_manager: &mut PortIODeviceManager,
+    mmio_device_manager: &mut MMIODeviceManager,
+    intc: Option<Arc<Mutex<IrqChipDevice>>>,
+) -> std::result::Result<(), StartMicrovmError> {
+    pio_device_manager
+        .register_devices()
+        .map_err(Error::LegacyIOBus)
+        .map_err(StartMicrovmError::Internal)?;
+
+    mmio_device_manager
+        .register_mmio_ioapic(intc)
+        .map_err(Error::RegisterMMIODevice)
+        .map_err(StartMicrovmError::Internal)?;
+
+    Ok(())
+}
