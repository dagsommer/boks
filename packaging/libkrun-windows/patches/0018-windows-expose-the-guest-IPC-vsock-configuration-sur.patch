-#[cfg(unix)]
 #[unsafe(no_mangle)]
 pub extern "C" fn krun_add_vsock(ctx_id: u32, tsi_features: u32) -> i32 {
     let tsi_flags = match TsiFlags::from_bits(tsi_features) {
@@ -2770,6 +2728,15 @@ pub extern "C" fn krun_add_vsock(ctx_id: u32, tsi_features: u32) -> i32 {
         None => return -libc::EINVAL,
     };
 
+    // Enabling the device with no feature bits is what a guest-IPC-only
+    // consumer wants, and that works everywhere. Only the TSI hijacking bits
+    // need a Unix host, so refuse those rather than the whole call.
+    #[cfg(windows)]
+    if tsi_flags.tsi_enabled() {
+        error!("TSI is not supported on Windows: no TSI backend is built");
+        return -libc::ENOTSUP;
+    }
+
     if cfg!(target_os = "macos") && tsi_flags.contains(TsiFlags::HIJACK_UNIX) {
         error!("TSI hijacking of UNIX sockets is not yet supported on macOS");
         return -libc::EINVAL;
@@ -3191,14 +3158,17 @@ pub extern "C" fn krun_start_enter(ctx_id: u32) -> i32 {
         return -libc::EINVAL;
     }
 
-    #[cfg(unix)]
     match &ctx_cfg.vsock_config {
         VsockConfig::Disabled => (),
         VsockConfig::Explicit { tsi_flags } => {
             let vsock_device_config = VsockDeviceConfig {
                 vsock_id: "vsock0".to_string(),
                 guest_cid: 3,
+                #[cfg(unix)]
                 host_port_map: ctx_cfg.tsi_port_map,
+                // Fed only by krun_set_port_map(), which is TSI.
+                #[cfg(windows)]
+                host_port_map: None,
                 unix_ipc_port_map: ctx_cfg.unix_ipc_port_map.clone(),
                 tsi_flags: *tsi_flags,
             };
