diff --git a/src/whp/src/aligned.rs b/src/whp/src/aligned.rs
new file mode 100644
index 0000000..3e7bc46
--- /dev/null
+++ b/src/whp/src/aligned.rs
@@ -0,0 +1,326 @@
+// Copyright 2026 Red Hat, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Alignment-correcting wrappers for the WHP types that `windows-sys` declares
+//! under-aligned.
+//!
+//! # The bug
+//!
+//! `WinHvPlatformDefs.h` (Windows SDK 10.0.26100) declares
+//!
+//! ```c
+//! typedef union DECLSPEC_ALIGN(16) WHV_UINT128 { ... } WHV_UINT128;
+//! ```
+//!
+//! and the alignment propagates to every type that embeds it — most
+//! importantly `WHV_REGISTER_VALUE` (whose `Reg128` member is a `WHV_UINT128`)
+//! and `WHV_RUN_VP_EXIT_CONTEXT` (whose exit-context union contains
+//! `WHV_HYPERCALL_CONTEXT`, an array of six `WHV_UINT128`).
+//!
+//! `windows-sys` 0.61.2 emits all of these as plain `#[repr(C)]` with no
+//! `align(16)`. Their largest primitive member is a `u64`, so Rust computes an
+//! alignment of 8. The *sizes* are right — 16 for `WHV_REGISTER_VALUE`, 224 for
+//! `WHV_RUN_VP_EXIT_CONTEXT`, verified against the header's own `C_ASSERT`s —
+//! only the alignment is wrong, which is exactly the kind of mismatch that
+//! produces a crash rather than a compile error.
+//!
+//! A `[WHV_REGISTER_VALUE; N]` built on the stack therefore lands on an
+//! 8-mod-16 address roughly half the time, depending on the caller's frame
+//! layout, and `WHvSetVirtualProcessorRegisters` faults when it dereferences it
+//! with an alignment-assuming (SSE) load. That is a deterministic,
+//! call-site-dependent access violation: the same helper works from one caller
+//! and dies from another.
+//!
+//! This is a `windows-sys` metadata bug and is worth reporting upstream; until
+//! it is fixed there, correcting it here is not optional.
+//!
+//! # The fix
+//!
+//! Wrap each affected type in a `#[repr(C, align(16))]` newtype. The wrapper
+//! has exactly one field, so it has the same size and field offsets as the
+//! inner type, and raising its alignment to 16 does not change its size (16 and
+//! 224 are both multiples of 16). An array of wrappers therefore has *exactly*
+//! the layout a C compiler gives an array of the properly-aligned C type, so
+//! `&[AlignedRegisterValue]` can be handed straight to WHP as a
+//! `const WHV_REGISTER_VALUE*`.
+//!
+//! The `const _: () = assert!(...)` guards below are the point of this module
+//! as much as the wrappers are: if a future `windows-sys` bump changes any of
+//! these layouts — including "fixing" the alignment, which the wrappers absorb
+//! harmlessly — the build fails with a readable message instead of regressing
+//! into another access violation months later.
+//!
+//! # Types checked
+//!
+//! Every `WHV_*` record `windows-sys` 0.61.2 exposes was compared against the
+//! SDK headers compiled for `x86_64-pc-windows-msvc`. Nine differ, all of them
+//! alignment-only, all of them rooted in the missing `align(16)` on
+//! `WHV_UINT128`:
+//!
+//! | type | C (size/align) | windows-sys |
+//! |---|---|---|
+//! | `WHV_UINT128` | 16/16 | 16/8 |
+//! | `WHV_REGISTER_VALUE` | 16/16 | 16/8 |
+//! | `WHV_RUN_VP_EXIT_CONTEXT` | 224/16 | 224/8 |
+//! | `WHV_HYPERCALL_CONTEXT` | 176/16 | 176/8 |
+//! | `WHV_X64_FP_REGISTER` | 16/16 | 16/8 |
+//! | `WHV_X64_FP_CONTROL_STATUS_REGISTER` | 16/16 | 16/8 |
+//! | `WHV_X64_XMM_CONTROL_STATUS_REGISTER` | 16/16 | 16/8 |
+//! | `WHV_X64_PENDING_EXCEPTION_EVENT` | 16/16 | 16/8 |
+//! | `WHV_X64_PENDING_EXT_INT_EVENT` | 16/16 | 16/8 |
+//!
+//! Of those, only two are ever handed to WHP by this crate as an object in
+//! their own right — `WHV_REGISTER_VALUE` and `WHV_RUN_VP_EXIT_CONTEXT` — and
+//! those are the two wrapped here. The other seven are only ever reached as
+//! members of a `WHV_REGISTER_VALUE` (the FP/XMM/pending-event registers) or of
+//! a `WHV_RUN_VP_EXIT_CONTEXT` (`WHV_HYPERCALL_CONTEXT`), so aligning the two
+//! containers aligns them too. Every other WHP type this crate passes across
+//! the FFI boundary — `WHV_CAPABILITY`, `WHV_PARTITION_PROPERTY`,
+//! `WHV_X64_CPUID_RESULT`, `WHV_INTERRUPT_CONTROL`, `WHV_EMULATOR_CALLBACKS`,
+//! `WHV_EMULATOR_STATUS`, `WHV_EMULATOR_IO_ACCESS_INFO`,
+//! `WHV_EMULATOR_MEMORY_ACCESS_INFO`, `WHV_TRANSLATE_GVA_RESULT`,
+//! `WHV_MEMORY_ACCESS_CONTEXT`, `WHV_X64_IO_PORT_ACCESS_CONTEXT`,
+//! `WHV_VP_EXIT_CONTEXT`, `WHV_PROCESSOR_FEATURES_BANKS` — matches the C
+//! layout exactly and needs no wrapper.
+
+use std::mem;
+use std::ops::{Deref, DerefMut};
+
+use windows_sys::Win32::System::Hypervisor::{WHV_REGISTER_VALUE, WHV_RUN_VP_EXIT_CONTEXT};
+
+/// The alignment `DECLSPEC_ALIGN(16)` imposes on `WHV_UINT128` and everything
+/// that embeds it.
+pub const WHP_ALIGN: usize = 16;
+
+/// A `WHV_REGISTER_VALUE` with the 16-byte alignment WHP actually requires.
+///
+/// See the [module docs](self) for why this exists. Use it anywhere a register
+/// value crosses the FFI boundary; the [`Deref`]/[`DerefMut`] impls make the
+/// union's fields directly reachable, so `value.Reg64` and `value.Segment.Base`
+/// work exactly as they did on the bare type.
+#[repr(C, align(16))]
+#[derive(Clone, Copy)]
+pub struct AlignedRegisterValue(pub WHV_REGISTER_VALUE);
+
+// Guards. Do not delete these when bumping `windows-sys`: they are what turns a
+// silently changed layout back into a build failure instead of a fault inside
+// WHP. `WinHvPlatformDefs.h` asserts `sizeof(WHV_REGISTER_VALUE) == 16` itself.
+const _: () = assert!(
+    mem::size_of::<WHV_REGISTER_VALUE>() == 16,
+    "windows-sys WHV_REGISTER_VALUE is no longer 16 bytes; the WHP ABI says it must be"
+);
+const _: () = assert!(
+    mem::size_of::<AlignedRegisterValue>() == mem::size_of::<WHV_REGISTER_VALUE>(),
+    "AlignedRegisterValue must not add padding: WHP indexes arrays of it"
+);
+const _: () = assert!(
+    mem::align_of::<AlignedRegisterValue>() == WHP_ALIGN,
+    "AlignedRegisterValue must be 16-byte aligned; WHP dereferences it with aligned loads"
+);
+
+impl AlignedRegisterValue {
+    /// An all-zero register value.
+    pub fn zeroed() -> Self {
+        // A union of integers and bitfields: all-zero is a valid value of every
+        // member.
+        Self(unsafe { mem::zeroed() })
+    }
+
+    /// A register value holding `value` in its 64-bit member.
+    pub fn from_reg64(value: u64) -> Self {
+        let mut v = Self::zeroed();
+        v.0.Reg64 = value;
+        v
+    }
+
+    /// Reads the 64-bit member.
+    ///
+    /// Every WHP register is at most 128 bits and the union is fully
+    /// initialised by construction, so reading `Reg64` out of a value produced
+    /// by this crate is always a defined (if possibly meaningless) read.
+    pub fn reg64(&self) -> u64 {
+        unsafe { self.0.Reg64 }
+    }
+
+    /// Borrows a WHP-owned buffer of register values as aligned wrappers.
+    ///
+    /// This is for the instruction emulator's register callbacks, which are
+    /// handed a `(pointer, count)` pair that WHP allocated. WHP compiles
+    /// against the properly-aligned C declaration, so its buffers *are* 16-byte
+    /// aligned — but rather than take that on faith and construct a reference
+    /// that would be UB if it were ever false, the alignment is checked and a
+    /// misaligned buffer is reported to the caller as `None`.
+    ///
+    /// # Safety
+    ///
+    /// `ptr` must point to `len` initialised, contiguous `WHV_REGISTER_VALUE`s
+    /// that stay valid and unaliased for `'a`.
+    pub unsafe fn slice_from_raw<'a>(
+        ptr: *const WHV_REGISTER_VALUE,
+        len: usize,
+    ) -> Option<&'a [Self]> {
+        if ptr.is_null() || (ptr as usize) % WHP_ALIGN != 0 {
+            return None;
+        }
+        // Same size and field offsets as the pointee; the alignment check above
+        // establishes the only property the cast adds.
+        Some(unsafe { std::slice::from_raw_parts(ptr.cast::<Self>(), len) })
+    }
+
+    /// Mutable counterpart of [`AlignedRegisterValue::slice_from_raw`].
+    ///
+    /// # Safety
+    ///
+    /// As [`AlignedRegisterValue::slice_from_raw`], and `ptr` must additionally
+    /// be unaliased for writes for `'a`.
+    pub unsafe fn slice_from_raw_mut<'a>(
+        ptr: *mut WHV_REGISTER_VALUE,
+        len: usize,
+    ) -> Option<&'a mut [Self]> {
+        if ptr.is_null() || (ptr as usize) % WHP_ALIGN != 0 {
+            return None;
+        }
+        Some(unsafe { std::slice::from_raw_parts_mut(ptr.cast::<Self>(), len) })
+    }
+}
+
+impl Deref for AlignedRegisterValue {
+    type Target = WHV_REGISTER_VALUE;
+
+    fn deref(&self) -> &Self::Target {
+        &self.0
+    }
+}
+
+impl DerefMut for AlignedRegisterValue {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        &mut self.0
+    }
+}
+
+impl From<WHV_REGISTER_VALUE> for AlignedRegisterValue {
+    fn from(value: WHV_REGISTER_VALUE) -> Self {
+        Self(value)
+    }
+}
+
+impl From<AlignedRegisterValue> for WHV_REGISTER_VALUE {
+    fn from(value: AlignedRegisterValue) -> Self {
+        value.0
+    }
+}
+
+/// A `WHV_RUN_VP_EXIT_CONTEXT` with the 16-byte alignment WHP requires.
+///
+/// `WHvRunVirtualProcessor` writes into this buffer, and the exit-context union
+/// includes `WHV_HYPERCALL_CONTEXT` with its six `WHV_UINT128` XMM registers,
+/// so the C declaration is 16-byte aligned and the buffer we hand it has to be
+/// too. Nothing in this crate reads the hypercall context — we never enable
+/// hypercall exits — but the alignment is a property of the *buffer* WHP
+/// writes, not of the member we happen to read afterwards.
+#[repr(C, align(16))]
+#[derive(Clone, Copy)]
+pub struct AlignedExitContext(pub WHV_RUN_VP_EXIT_CONTEXT);
+
+// Same rationale as the guards on `AlignedRegisterValue`.
+// `WinHvPlatformDefs.h` asserts `sizeof(WHV_RUN_VP_EXIT_CONTEXT) == 224` on
+// AMD64.
+const _: () = assert!(
+    mem::size_of::<WHV_RUN_VP_EXIT_CONTEXT>() == 224,
+    "windows-sys WHV_RUN_VP_EXIT_CONTEXT is no longer 224 bytes; the WHP ABI says it must be"
+);
+const _: () = assert!(
+    mem::size_of::<AlignedExitContext>() == mem::size_of::<WHV_RUN_VP_EXIT_CONTEXT>(),
+    "AlignedExitContext must not add padding: its size is passed to WHvRunVirtualProcessor"
+);
+const _: () = assert!(
+    mem::align_of::<AlignedExitContext>() == WHP_ALIGN,
+    "AlignedExitContext must be 16-byte aligned; WHvRunVirtualProcessor writes it with aligned stores"
+);
+
+impl AlignedExitContext {
+    /// An all-zero exit context, matching the previous `mem::zeroed()`
+    /// initialisation of the field.
+    pub fn zeroed() -> Self {
+        Self(unsafe { mem::zeroed() })
+    }
+}
+
+impl Deref for AlignedExitContext {
+    type Target = WHV_RUN_VP_EXIT_CONTEXT;
+
+    fn deref(&self) -> &Self::Target {
+        &self.0
+    }
+}
+
+impl DerefMut for AlignedExitContext {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        &mut self.0
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The compile-time guards prove the *type* is 16-byte aligned; this proves
+    /// the property that actually mattered at the crash site, namely that an
+    /// array of them built on the stack lands on a 16-byte boundary regardless
+    /// of the caller's frame layout. `set_registers64` builds exactly such an
+    /// array and hands its address to WHP.
+    #[test]
+    fn stack_arrays_are_16_byte_aligned() {
+        fn check<const N: usize>() {
+            let values = [AlignedRegisterValue::zeroed(); N];
+            assert_eq!(
+                values.as_ptr() as usize % WHP_ALIGN,
+                0,
+                "[AlignedRegisterValue; {N}] must start on a 16-byte boundary"
+            );
+            // Stride has to match the C array too, not just the start.
+            assert_eq!(mem::size_of_val(&values), N * 16);
+        }
+
+        // A spread of lengths, and a misaligning local in between, so that the
+        // frame offsets differ from one another.
+        check::<1>();
+        let _pad: u64 = 0;
+        check::<2>();
+        let _pad2: [u8; 3] = [0; 3];
+        check::<5>();
+        check::<13>();
+
+        let ctx = AlignedExitContext::zeroed();
+        assert_eq!(&ctx as *const _ as usize % WHP_ALIGN, 0);
+    }
+
+    /// A misaligned buffer must be rejected rather than turned into a reference,
+    /// which would be UB.
+    #[test]
+    fn slice_from_raw_rejects_misaligned_and_null() {
+        let mut backing = [AlignedRegisterValue::zeroed(); 4];
+        let base = backing.as_mut_ptr().cast::<WHV_REGISTER_VALUE>();
+
+        assert!(unsafe { AlignedRegisterValue::slice_from_raw(base, 4) }.is_some());
+        assert!(unsafe { AlignedRegisterValue::slice_from_raw_mut(base, 4) }.is_some());
+
+        // 8 bytes into a 16-byte-aligned buffer: aligned for windows-sys,
+        // misaligned for WHP. This is the address `set_registers64` was handing
+        // over half the time.
+        let skewed = unsafe { base.cast::<u64>().add(1) }.cast::<WHV_REGISTER_VALUE>();
+        assert!(unsafe { AlignedRegisterValue::slice_from_raw(skewed, 3) }.is_none());
+        assert!(unsafe { AlignedRegisterValue::slice_from_raw_mut(skewed, 3) }.is_none());
+
+        assert!(unsafe { AlignedRegisterValue::slice_from_raw(std::ptr::null(), 0) }.is_none());
+    }
+
+    #[test]
+    fn reg64_round_trips() {
+        assert_eq!(
+            AlignedRegisterValue::from_reg64(0xdead_beef_1234_5678).reg64(),
+            0xdead_beef_1234_5678
+        );
+        assert_eq!(AlignedRegisterValue::zeroed().reg64(), 0);
+    }
+}
