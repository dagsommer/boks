 pub type Result<T> = result::Result<T, Error>;
 
+/// Where an application processor is in its bring-up.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum ApParkState {
+    /// Held outside the guest: its thread has not called
+    /// `WHvRunVirtualProcessor` and will not until a startup IPI arrives.
+    Parked,
+    /// A startup IPI arrived carrying this vector. The AP's own thread applies
+    /// it — nobody writes another processor's registers — and then runs.
+    SipiPending(u8),
+    /// Executing guest code.
+    Running,
+}
+
+struct ApStartupState {
+    /// Indexed by processor index; `slots[0]` is the BSP and is always
+    /// [`ApParkState::Running`].
+    slots: Vec<ApParkState>,
+    /// The xAPIC ID WHP gave each processor, indexed by processor index. The
+    /// guest addresses IPIs by APIC ID, so this is the map that turns a trapped
+    /// ICR's destination field back into an index.
+    apic_ids: Vec<u32>,
+    /// Set when any vCPU stops, so that APs the guest never started do not
+    /// leave their threads blocked forever.
+    shutdown: bool,
+}
+
+/// Starts application processors on the guest's behalf.
+///
+/// # Which side starts APs under WHP
+///
+/// Neither the claim this backend used to carry ("WHP starts every virtual
+/// processor runnable, so the wait has to be expressed as code") nor its
+/// opposite ("WHP's local APIC emulation does not start APs itself") is the
+/// whole truth, and Microsoft documents neither. What the headers and the
+/// existing consumers between them establish is that **it is a choice the VMM
+/// makes**, by way of one capability bit:
+///
+/// * With `WHV_EXTENDED_VM_EXITS.X64ApicInitSipiExitTrap` clear, WHP's
+///   in-hypervisor local APIC applies INIT and SIPI itself. crosvm's
+///   `WhpxSplitIrqChip`, QEMU's `kernel-irqchip=on` path and Microsoft's own
+///   openvmm all run xAPIC/x2APIC emulation with that bit clear, contain no
+///   INIT/SIPI logic whatsoever, and support SMP guests. crosvm goes further
+///   and writes down that "Whpx handles VCPU blocking".
+/// * With the bit set — which is what `WhpVm::configure_partition` asks for
+///   whenever the partition has more than one processor — the guest's ICR write
+///   comes out as a `WHvRunVpExitReasonX64ApicInitSipiTrap` exit on the writing
+///   vCPU instead, and starting the target becomes the VMM's job. That is what
+///   this type does.
+///
+/// # Why take the trap at all, if WHP would do it
+///
+/// Because the one thing that is *not* settled is the state a freshly created
+/// virtual processor is in. crosvm and QEMU both write a boot state into every
+/// vCPU and then call `WHvRunVirtualProcessor` on all of them at once, which
+/// only works if WHP holds APs in wait-for-SIPI; but openvmm's OpenHCL backend,
+/// against the same hypervisor through a different interface, states the
+/// reverse outright — "The hypervisor initializes startup suspend to false.
+/// Application processors must instead come up in the wait-for-SIPI state" —
+/// and sets the flag itself.
+///
+/// Taking the trap makes that question moot rather than answering it. An AP's
+/// thread never enters the guest before its startup IPI, so it does not matter
+/// whether WHP would have let it; and
+/// `arch::x86_64::regs::apply_sipi_startup_state` clears `StartupSuspend`
+/// unconditionally, so it does not matter whether WHP had set it. The design is
+/// correct under both readings, which is the property worth having for code
+/// that cannot be tested here.
+///
+/// # What is inferred rather than documented
+///
+/// Three properties of the trap itself have no documentation and no other
+/// consumer to copy from — no project found enables this bit:
+///
+/// * that the exit is raised on the *sending* vCPU (the context carries only
+///   the ICR value, and `WHvRunVirtualProcessor` returns per-processor, so
+///   there is nowhere else it could sensibly go);
+/// * that `ApicIcr` is the two 32-bit xAPIC ICR halves combined, destination in
+///   bits 56..63, as `WHvRunVpExitReasonX64ApicSmiTrap` presents the same
+///   field;
+/// * that the instruction has already retired, as the "Trap" in the name
+///   implies, so RIP must not be advanced.
+///
+/// The first two fail visibly and harmlessly: a trap that never arrives leaves
+/// the APs parked and the guest reporting them as unresponsive, and an ICR that
+/// decodes to nothing recognised is logged verbatim at warn level. The third
+/// would wedge the *sending* vCPU in a loop, so [`Vcpu::run_emulation`] counts
+/// consecutive traps at one address and fails the vCPU with
+/// [`Error::VcpuInitSipiTrapLoop`] rather than hanging.
+pub struct ApStartupRouter {
+    state: Mutex<ApStartupState>,
+    /// Signals a parked AP that its slot changed, or that the VM is going away.
+    wakeup: Condvar,
+}
+
+impl ApStartupRouter {
+    /// ICR bits 8..10, delivery mode: INIT.
+    const DELIVERY_MODE_INIT: u64 = 0b101;
+    /// ICR bits 8..10, delivery mode: startup (SIPI).
+    const DELIVERY_MODE_STARTUP: u64 = 0b110;
+    /// ICR bit 11: destination mode is logical rather than physical.
+    const DEST_MODE_LOGICAL: u64 = 1 << 11;
+    /// ICR bit 14: level. Clear on the level-triggered INIT de-assert.
+    const LEVEL_ASSERT: u64 = 1 << 14;
+    /// ICR bits 18..19, destination shorthand.
+    const SHORTHAND_NONE: u64 = 0b00;
+    const SHORTHAND_SELF: u64 = 0b01;
+    const SHORTHAND_ALL_INCLUDING_SELF: u64 = 0b10;
+    const SHORTHAND_ALL_EXCLUDING_SELF: u64 = 0b11;
+    /// Physical destination 0xff is the broadcast APIC ID.
+    const DEST_BROADCAST: u32 = 0xff;
+
+    fn new(vcpu_count: u8) -> Self {
+        let slots = (0..vcpu_count)
+            .map(|id| {
+                // The BSP is started by this backend, at the kernel entry
+                // point; only the APs wait for the guest.
+                if id == 0 {
+                    ApParkState::Running
+                } else {
+                    ApParkState::Parked
+                }
+            })
+            .collect();
+
+        Self {
+            state: Mutex::new(ApStartupState {
+                slots,
+                // Overwritten per processor by `set_apic_id`. The identity map
+                // is the fallback for a path that never creates vCPUs through
+                // `Vcpu::new_x86_64`, and is what WHP is expected to assign
+                // anyway.
+                apic_ids: (0..u32::from(vcpu_count)).collect(),
+                shutdown: false,
+            }),
+            wakeup: Condvar::new(),
+        }
+    }
+
+    fn vcpu_count(&self) -> u8 {
+        self.state.lock().unwrap().slots.len() as u8
+    }
+
+    /// Records the xAPIC ID WHP assigned to a processor.
+    fn set_apic_id(&self, index: u8, apic_id: u32) {
+        let mut state = self.state.lock().unwrap();
+        if let Some(slot) = state.apic_ids.get_mut(index as usize) {
+            *slot = apic_id;
+        }
+    }
+
+    /// Whether a processor is in the guest as far as the router is concerned.
+    /// A vCPU that finds itself no longer running has been re-parked by an INIT
+    /// and must leave the guest.
+    fn is_running(&self, index: u8) -> bool {
+        let state = self.state.lock().unwrap();
+        state.slots.get(index as usize) == Some(&ApParkState::Running)
+    }
+
+    /// Wakes every parked AP so its thread can exit.
+    fn shutdown(&self) {
+        self.state.lock().unwrap().shutdown = true;
+        self.wakeup.notify_all();
+    }
+
+    /// Blocks an AP's thread until the guest sends it a startup IPI, and
+    /// returns the vector it carried. `None` means the VM is going away.
+    fn wait_for_sipi(&self, index: u8) -> Option<u8> {
+        let mut state = self.state.lock().unwrap();
+        loop {
+            if state.shutdown {
+                return None;
+            }
+            // Latching Running here, rather than after the registers are
+            // written, is deliberate: the second SIPI of the guest's
+            // INIT-SIPI-SIPI is meant to be swallowed by an AP that the first
+            // one already started, and this is what makes it a no-op.
+            if let ApParkState::SipiPending(vector) = state.slots[index as usize] {
+                state.slots[index as usize] = ApParkState::Running;
+                debug!("vCPU {index} unparked by a startup IPI, vector 0x{vector:x}");
+                return Some(vector);
+            }
+            state = self.wakeup.wait(state).unwrap();
+        }
+    }
+
+    /// Applies a trapped write to the local APIC's interrupt command register.
+    ///
+    /// `vm` is needed to break a target that is *already* in the guest out of
+    /// `WHvRunVirtualProcessor`, which is how an INIT reaches a processor the
+    /// guest is taking back — an offlined CPU being brought online again, or a
+    /// kexec. Without it such a target would keep running until its next exit.
+    fn deliver_icr(&self, sender: u8, icr: u64, vm: &WhpVm) {
+        let delivery_mode = (icr >> 8) & 0x7;
+        let vector = (icr & 0xff) as u8;
+
+        match delivery_mode {
+            Self::DELIVERY_MODE_INIT => {
+                // The level-triggered de-assert that follows every INIT assert
+                // carries destination 0 and no shorthand. Taken at face value
+                // it reads as "INIT the processor with APIC ID 0" — the BSP,
+                // mid-boot. Bit 14 is what tells the two apart, and this is the
+                // single most damaging thing to get wrong here.
+                if icr & Self::LEVEL_ASSERT == 0 {
+                    trace!("vCPU {sender}: INIT de-assert (icr=0x{icr:x}); ignored");
+                    return;
+                }
+            }
+            Self::DELIVERY_MODE_STARTUP => {}
+            _ => {
+                // NMI, SMI and fixed IPIs are delivered by WHP's own local APIC
+                // emulation and should never reach this trap.
+                warn!("vCPU {sender}: unexpected trapped IPI ignored (icr=0x{icr:x})");
+                return;
+            }
+        }
+
+        let Some(targets) = self.resolve_targets(sender, icr) else {
+            return;
+        };
+
+        let mut state = self.state.lock().unwrap();
+        for target in targets {
+            if target == sender {
+                // Reachable through the self and all-including-self shorthands.
+                // A processor cannot put itself into wait-for-SIPI here: it is
+                // the one holding this exit.
+                trace!("vCPU {sender}: INIT/SIPI addressed to itself ignored");
+                continue;
+            }
+            if target == 0 {
+                // Resetting the boot processor would mean re-running the whole
+                // boot-state setup, which this backend has no path for. Nothing
+                // in a Linux SMP bring-up does it.
+                warn!("vCPU {sender}: INIT/SIPI to the boot processor ignored (icr=0x{icr:x})");
+                continue;
+            }
+            let slot = &mut state.slots[target as usize];
+
+            if delivery_mode == Self::DELIVERY_MODE_INIT {
+                if *slot == ApParkState::Running {
+                    // Put it back in wait-for-SIPI and get it out of the guest
