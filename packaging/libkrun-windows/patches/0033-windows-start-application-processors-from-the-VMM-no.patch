+/// Puts a parked AP into the state a startup IPI leaves a processor in, and
+/// releases it to run.
+///
+/// The architectural effect of a SIPI carrying vector `V` is that the target
+/// begins executing in real mode at `CS = V << 8`, `CS.base = V << 12`,
+/// `IP = 0`, with everything else still holding the reset state it had while
+/// waiting. That is exactly what is written here, which is why
+/// [`setup_regs`] and [`setup_sregs`] must leave an AP's control registers at
+/// their power-on values: CR0.PE clear, no paging, no long mode. Handing the
+/// guest's 16-bit trampoline a vCPU that this backend had already switched into
+/// long mode would fault on its first instruction.
+///
+/// `WHvRegisterInternalActivityState` is cleared in the same call. Its bit 0 is
+/// `StartupSuspend`, the hypervisor's own wait-for-SIPI flag; a virtual
+/// processor holding it does not fetch instructions no matter what its
+/// registers say. Whether WHP sets it on a freshly created AP is undocumented,
+/// so the clear is unconditional: writing zero to a register that is already
+/// zero costs nothing, and skipping it on a processor that *is* suspended would
+/// hang the guest with no symptom beyond an AP that never appears.
+///
+/// Writing the register is the synchronous way to do this. The asynchronous
+/// alternative — asking WHP to deliver a SIPI with `WHvRequestInterrupt` —
+/// races the guest's own INIT-SIPI-SIPI sequence, a race Microsoft's own
+/// openvmm documents and avoids the same way.
+pub fn apply_sipi_startup_state(vcpu: &whp::WhpVcpu, vector: u8) -> Result<()> {
+    let mut cs = AlignedRegisterValue::zeroed();
+    // SAFETY: `AlignedRegisterValue` wraps `WHV_REGISTER_VALUE`; writing the
+    // `Segment` member is how a segment register is composed for WHP.
+    let seg = unsafe { &mut cs.Segment };
+    seg.Base = u64::from(vector) << 12;
+    seg.Limit = 0xffff;
+    seg.Selector = u16::from(vector) << 8;
+    // Present, S=1, type 0xb (code, execute/read, accessed); L and D/B clear,
+    // i.e. a 16-bit code segment. Same packing as `setup_sregs` uses.
+    seg.Anonymous.Anonymous._bitfield = 0x9b;
+
+    vcpu.set_registers([
+        (WHvX64RegisterCs, cs),
+        (WHvX64RegisterRip, AlignedRegisterValue::from_reg64(0)),
+        // Bit 1 reads as one; every other flag is clear at reset, IF included,
+        // so the AP starts with interrupts masked as the architecture requires.
+        (WHvX64RegisterRflags, AlignedRegisterValue::from_reg64(0x2)),
+        (
+            WHvRegisterInternalActivityState,
+            AlignedRegisterValue::from_reg64(0),
+        ),
+    ])
+    .map_err(Error::SetWhpRegisters)
+}
