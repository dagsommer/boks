diff --git a/src/vmm/src/windows/emulator.rs b/src/vmm/src/windows/emulator.rs
new file mode 100644
index 0000000..14740b8
--- /dev/null
+++ b/src/vmm/src/windows/emulator.rs
@@ -0,0 +1,281 @@
+// Copyright 2026 Red Hat, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Callbacks for the Windows Hypervisor Platform instruction emulator.
+//!
+//! WHP reports an I/O port or MMIO intercept as a bare "the guest touched this
+//! address" event: unlike KVM, it does not decode the faulting instruction for
+//! us, so the exit context carries no access size, no direction and no data.
+//! What it offers instead is `WHvEmulatorTry{Io,Mmio}Emulation`, an x86
+//! decoder that walks the instruction and calls back into us for every piece it
+//! cannot resolve on its own — the actual I/O, the register reads and writes,
+//! and any guest-virtual-to-guest-physical translation. It also advances RIP
+//! and commits the register side effects, which is why nothing in this file
+//! touches RIP.
+//!
+//! The HVF backend has no equivalent: on aarch64 `hv_vcpu_run` hands back a
+//! fully decoded ESR (address, width, direction, register) and the MMIO
+//! dispatch is a direct `mmio_bus.read()/write()`. Everything here exists
+//! purely because the x86 exit does not carry that information.
+//!
+//! # Lifetime and threading contract
+//!
+//! WHP invokes these callbacks *synchronously*, on the calling thread, before
+//! `WHvEmulatorTry{Io,Mmio}Emulation` returns. The `context` pointer we hand it
+//! is therefore allowed to point at a stack local of the caller, and the
+//! borrows inside [`EmulatorContext`] stay live for exactly as long as the
+//! emulation call. Nothing here may stash the pointer.
+
+use std::ffi::c_void;
+use std::slice;
+
+use vm_memory::{Bytes, GuestAddress, GuestMemoryMmap};
+use windows_sys::Win32::Foundation::{E_FAIL, E_INVALIDARG, S_OK};
+use windows_sys::Win32::System::Hypervisor::{
+    WHV_EMULATOR_CALLBACKS, WHV_EMULATOR_IO_ACCESS_INFO, WHV_EMULATOR_MEMORY_ACCESS_INFO,
+    WHV_REGISTER_NAME, WHV_REGISTER_VALUE, WHV_TRANSLATE_GVA_FLAGS, WHV_TRANSLATE_GVA_RESULT_CODE,
+};
+use windows_sys::core::HRESULT;
+
+/// Direction field shared by `WHV_EMULATOR_IO_ACCESS_INFO` and
+/// `WHV_EMULATOR_MEMORY_ACCESS_INFO`: 0 means the guest is reading (`IN` /
+/// load), 1 means it is writing (`OUT` / store).
+const ACCESS_DIRECTION_READ: u8 = 0;
+
+/// Everything the callbacks need to service one emulation call.
+///
+/// Borrowed rather than owned so that constructing it costs nothing on the
+/// per-exit path; see the module-level note on why the borrows are sound.
+pub(crate) struct EmulatorContext<'a> {
+    /// The vCPU that took the intercept. Used for the register and
+    /// address-translation callbacks, which WHP routes back through us rather
+    /// than servicing internally.
+    pub vcpu: &'a whp::WhpVcpu,
+    /// vCPU index, passed to the bus so devices can tell callers apart.
+    pub vcpu_id: u64,
+    /// Port I/O bus (COM ports, i8042, CMOS).
+    pub io_bus: &'a devices::Bus,
+    /// MMIO bus (virtio-mmio transports, IOAPIC). `None` before
+    /// [`crate::vstate::Vcpu::set_mmio_bus`] has run, which cannot happen once
+    /// the guest is executing, but the field is an `Option` to match the
+    /// existing backends.
+    pub mmio_bus: Option<&'a devices::Bus>,
+    /// Guest RAM, for the case described in [`memory_callback`].
+    pub guest_memory: &'a GuestMemoryMmap,
+}
+
+impl EmulatorContext<'_> {
+    /// Pointer to hand to `WHvEmulatorTry*Emulation` as its `context` argument.
+    pub fn as_ptr(&self) -> *const c_void {
+        self as *const Self as *const c_void
+    }
+}
+
+/// Reconstitute the context from the opaque pointer WHP passes back.
+///
+/// # Safety
+///
+/// `context` must be the pointer produced by [`EmulatorContext::as_ptr`] for a
+/// still-live `EmulatorContext`, which holds for every callback WHP makes from
+/// inside the emulation call that pointer was handed to.
+unsafe fn context<'a>(context: *const c_void) -> &'a EmulatorContext<'a> {
+    unsafe { &*(context as *const EmulatorContext) }
+}
+
+/// Services `IN`/`OUT` by routing to the port I/O bus.
+///
+/// `AccessSize` is 1, 2 or 4 bytes; `Data` carries the value as a native-endian
+/// `u32`, so it is the low `AccessSize` bytes of its little-endian encoding
+/// that the device sees. Getting that wrong would silently transpose bytes for
+/// every 2- and 4-byte port access, so the conversion is explicit.
+unsafe extern "system" fn io_port_callback(
+    ctx: *const c_void,
+    io_access: *mut WHV_EMULATOR_IO_ACCESS_INFO,
+) -> HRESULT {
+    let ctx = unsafe { context(ctx) };
+    let access = unsafe { &mut *io_access };
+
+    let size = access.AccessSize as usize;
+    if size == 0 || size > 4 {
+        error!(
+            "WHP emulator asked for a {}-byte port access on port 0x{:x}; only 1/2/4 are valid",
+            size, access.Port
+        );
+        return E_INVALIDARG;
+    }
+
+    let port = u64::from(access.Port);
+    if access.Direction == ACCESS_DIRECTION_READ {
+        let mut data = [0u8; 4];
+        ctx.io_bus.read(ctx.vcpu_id, port, &mut data[..size]);
+        access.Data = u32::from_le_bytes(data);
+    } else {
+        let data = access.Data.to_le_bytes();
+        ctx.io_bus.write(ctx.vcpu_id, port, &data[..size]);
+    }
+
+    S_OK
+}
+
+/// Services the memory operands of the faulting instruction.
+///
+/// The emulator calls this for *every* memory access the instruction makes,
+/// not just the one that caused the intercept. A `MOVS` from RAM into a virtio
+/// register, for instance, produces one read against ordinary guest RAM and one
+/// write against the MMIO bus. So this tries the MMIO bus first — a hit there
+/// is the device access we exited for — and falls back to guest RAM, which is
+/// the right answer for the operand that did not fault. Guest RAM cannot
+/// overlap the MMIO window (`arch::MMIO_MEM_START` sits in the 32-bit hole
+/// above the last RAM region), so the two cases cannot both match.
+///
+/// An address that is neither is a genuine fault, and is reported as such
+/// rather than quietly returning zeroes: a silent zero here would look to the
+/// guest like a successful read of a device that does not exist.
+unsafe extern "system" fn memory_callback(
+    ctx: *const c_void,
+    memory_access: *mut WHV_EMULATOR_MEMORY_ACCESS_INFO,
+) -> HRESULT {
+    let ctx = unsafe { context(ctx) };
+    let access = unsafe { &mut *memory_access };
+
+    let size = access.AccessSize as usize;
+    if size == 0 || size > access.Data.len() {
+        error!(
+            "WHP emulator asked for a {}-byte memory access at gpa 0x{:x}; the ABI allows at most {}",
+            size,
+            access.GpaAddress,
+            access.Data.len()
+        );
+        return E_INVALIDARG;
+    }
+
+    let gpa = access.GpaAddress;
+    let reading = access.Direction == ACCESS_DIRECTION_READ;
+
+    if let Some(mmio_bus) = ctx.mmio_bus {
+        let handled = if reading {
+            mmio_bus.read(ctx.vcpu_id, gpa, &mut access.Data[..size])
+        } else {
+            mmio_bus.write(ctx.vcpu_id, gpa, &access.Data[..size])
+        };
+        if handled {
+            return S_OK;
+        }
+    }
+
+    let result = if reading {
+        ctx.guest_memory
+            .read_slice(&mut access.Data[..size], GuestAddress(gpa))
+    } else {
+        ctx.guest_memory
+            .write_slice(&access.Data[..size], GuestAddress(gpa))
+    };
+
+    match result {
+        Ok(()) => S_OK,
+        Err(e) => {
+            error!(
+                "WHP emulator {} of {size} bytes at gpa 0x{gpa:x} hit neither a device nor guest \
+                 RAM: {e}",
+                if reading { "read" } else { "write" }
+            );
+            E_FAIL
+        }
+    }
+}
+
+/// Reads guest registers on the emulator's behalf.
+///
+/// WHP could read these itself; routing them through the VMM is what lets a
+/// VMM that caches register state stay authoritative. We do not cache, so this
+/// is a straight pass-through to `WHvGetVirtualProcessorRegisters`.
+unsafe extern "system" fn get_registers_callback(
+    ctx: *const c_void,
+    register_names: *const WHV_REGISTER_NAME,
+    register_count: u32,
+    register_values: *mut WHV_REGISTER_VALUE,
+) -> HRESULT {
+    let ctx = unsafe { context(ctx) };
+    let count = register_count as usize;
+    let names = unsafe { slice::from_raw_parts(register_names, count) };
+    let values = unsafe { slice::from_raw_parts_mut(register_values, count) };
+
+    match ctx.vcpu.get_whp_registers(names, values) {
+        Ok(()) => S_OK,
+        Err(e) => {
+            error!("WHP emulator register read failed: {e}");
+            E_FAIL
+        }
+    }
+}
+
+/// Writes guest registers on the emulator's behalf. This is how the decoded
+/// instruction's result — the destination register of an `IN`, the updated
+/// RIP, the flags — actually reaches the guest.
+unsafe extern "system" fn set_registers_callback(
+    ctx: *const c_void,
+    register_names: *const WHV_REGISTER_NAME,
+    register_count: u32,
+    register_values: *const WHV_REGISTER_VALUE,
+) -> HRESULT {
+    let ctx = unsafe { context(ctx) };
+    let count = register_count as usize;
+    let names = unsafe { slice::from_raw_parts(register_names, count) };
+    let values = unsafe { slice::from_raw_parts(register_values, count) };
+
+    match ctx.vcpu.set_whp_registers(names, values) {
+        Ok(()) => S_OK,
+        Err(e) => {
+            error!("WHP emulator register write failed: {e}");
+            E_FAIL
+        }
+    }
+}
+
+/// Translates a guest virtual address for the emulator, e.g. to find where a
+/// string instruction's source operand lives.
+///
+/// A failed *translation* (page not present, privilege violation, ...) is not
+/// a failed *call*: it is reported through `translation_result` with `S_OK`, and
+/// the emulator turns it into the page fault the guest should see. Only an
+/// error from WHP itself is an `E_FAIL`.
+unsafe extern "system" fn translate_gva_callback(
+    ctx: *const c_void,
+    gva: u64,
+    translate_flags: WHV_TRANSLATE_GVA_FLAGS,
+    translation_result: *mut WHV_TRANSLATE_GVA_RESULT_CODE,
+    gpa: *mut u64,
+) -> HRESULT {
+    let ctx = unsafe { context(ctx) };
+
+    match ctx.vcpu.translate_gva(gva, translate_flags) {
+        Ok((result_code, translated)) => {
+            unsafe {
+                *translation_result = result_code;
+                *gpa = translated;
+            }
+            S_OK
+        }
+        Err(e) => {
+            error!("WHP emulator GVA translation of 0x{gva:x} failed: {e}");
+            E_FAIL
+        }
+    }
+}
+
+/// The callback table handed to `WHvEmulatorCreateEmulator`.
+///
+/// `Size` is a versioning field: WHP rejects a table whose size it does not
+/// recognise, so it must describe the struct we were compiled against rather
+/// than a hardcoded number.
+pub(crate) fn callbacks() -> WHV_EMULATOR_CALLBACKS {
+    WHV_EMULATOR_CALLBACKS {
+        Size: std::mem::size_of::<WHV_EMULATOR_CALLBACKS>() as u32,
+        Reserved: 0,
+        WHvEmulatorIoPortCallback: Some(io_port_callback),
+        WHvEmulatorMemoryCallback: Some(memory_callback),
+        WHvEmulatorGetVirtualProcessorRegisters: Some(get_registers_callback),
+        WHvEmulatorSetVirtualProcessorRegisters: Some(set_registers_callback),
+        WHvEmulatorTranslateGvaPage: Some(translate_gva_callback),
+    }
+}
