+// Copyright 2026 Red Hat, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Windows Hypervisor Platform (WHP) backend.
+//!
+//! Structurally this follows the HVF backend rather than the KVM one: WHP is a
+//! user-mode hypervisor API with an explicit per-vCPU run loop, no in-kernel
+//! device emulation, no ioeventfd and no irqfd. Devices therefore raise
+//! interrupts by calling into the IOAPIC model in `krun-devices`, which turns
+//! them into `WHvRequestInterrupt` calls, rather than by writing an eventfd
+//! that the kernel picks up.
+//!
+//! The architecture is x86_64, so the register and boot setup follows the KVM
+//! x86_64 path (`arch::x86_64::regs` / `arch::x86_64::msr`, whose WHP variants
+//! live in `src/arch/src/x86_64/windows/`) rather than HVF's aarch64 one.
+//!
+//! ## What WHP has no equivalent for
+//!
+//! * **ioeventfd / irqfd.** No equivalent at all. `Vm` exposes no registration
+//!   for them and `device_manager::whp::mmio` does not try; devices signal
+//!   through the `IrqChip` instead, exactly as the HVF backend does.
+//! * **CPUID filtering.** KVM lets the VMM install a complete CPUID table with
+//!   `KVM_SET_CPUID2`, which is how `krun-cpuid` normalises topology and
+//!   applies the T2/C3 templates. WHP's `CpuidResultList` only *overrides*
+//!   individual leaves, and taking a full exit per CPUID needs
+//!   `WHvPartitionPropertyCodeCpuidExitList`, which the partition setup does not
+//!   request. CPU templates are therefore rejected rather than ignored — see
+//!   [`Vcpu::configure_x86_64`].
+//! * **Exception injection.** `WHvRequestInterrupt` delivers external
+//!   interrupts only. Injecting a `#GP` (which is what KVM does for an
+//!   unhandled MSR by default) would need `WHvX64RegisterPendingEvent`; see
+//!   [`Vcpu::handle_msr_access`] for the policy that is implemented instead.
+//! * **Pause / resume.** Not implemented. Unlike HVF there is no vtimer offset
+//!   to advance, but the guest TSC would still jump by the pause duration, and
+//!   nothing in the Windows path requests a pause today. `WhpVm::cancel_vcpu`
+//!   is the primitive a future implementation would build on.
+
+use std::fmt::{Display, Formatter};
+use std::io;
+use std::result;
+use std::sync::Arc;
+use std::thread;
+use std::time::Duration;
+
+use super::super::{FC_EXIT_CODE_GENERIC_ERROR, FC_EXIT_CODE_OK};
+use super::emulator::{self, EmulatorContext};
+use crate::vmm_config::machine_config::CpuFeaturesTemplate;
+
+use crossbeam_channel::{Receiver, Sender, unbounded};
+use utils::eventfd::EventFd;
+use vm_memory::{
+    Address, GuestAddress, GuestMemory, GuestMemoryError, GuestMemoryMmap, GuestMemoryRegion,
+};
+use whp::{VcpuExitReason, WhpEmulator, WhpVcpu, WhpVm};
+
+/// How long a vCPU parks after a `HLT` it can still be woken from, before
+/// re-entering the guest. See [`Vcpu::wait_for_interrupt`] for why this is a
+/// poll rather than a wait, and for the uncertainty it hedges against.
+const HALT_POLL_INTERVAL: Duration = Duration::from_micros(500);
+
+/// RFLAGS.IF — set when the guest can still take an external interrupt.
+const RFLAGS_IF: u64 = 1 << 9;
+
+/// Errors associated with the wrappers over the WHP API.
+#[derive(Debug)]
+pub enum Error {
+    /// A CPU template was requested, which WHP cannot honour.
+    CpuTemplateUnsupported(CpuFeaturesTemplate),
+    /// Error configuring the floating point related registers.
+    FPUConfiguration(arch::x86_64::regs::Error),
+    /// Invalid guest memory configuration.
+    GuestMemoryMmap(GuestMemoryError),
+    /// The Windows Hypervisor Platform is unavailable on this host.
+    HypervisorUnavailable(whp::Error),
+    /// Cannot create the instruction emulator.
+    CreateEmulator(whp::Error),
+    /// Error configuring the MSR registers.
+    MSRSConfiguration(arch::x86_64::msr::Error),
+    /// Error configuring the general purpose registers.
+    REGSConfiguration(arch::x86_64::regs::Error),
+    /// Error configuring the special registers.
+    SREGSConfiguration(arch::x86_64::regs::Error),
+    /// Cannot set the memory regions.
+    SetUserMemoryRegion(whp::Error),
+    /// The vCPU event channel was closed (the vCPU thread has exited).
+    VcpuChannelClosed,
+    /// Cannot create the virtual processor.
+    VcpuCreate(whp::Error),
+    /// vCPU count is not initialized.
+    VcpuCountNotInitialized,
+    /// Cannot run the VCPUs.
+    VcpuRun(whp::Error),
+    /// Cannot spawn a new vCPU thread.
+    VcpuSpawn(io::Error),
+    /// The emulator could not emulate the intercepted instruction.
+    VcpuEmulation(whp::Error),
+    /// An exit we have no handling for.
+    VcpuUnhandledWhpExit(u32),
+    /// Cannot access a vCPU register.
+    VcpuRegisterAccess(whp::Error),
+    /// Cannot configure the microvm.
+    VmSetup(whp::Error),
+}
+
+impl Display for Error {
+    fn fmt(&self, f: &mut Formatter) -> std::fmt::Result {
+        use self::Error::*;
+
+        match self {
+            CpuTemplateUnsupported(t) => write!(
+                f,
+                "CPU template {t:?} cannot be applied on WHP: the partition does not take CPUID \
+                 exits, so the template's CPUID entries could not be delivered to the guest"
+            ),
+            FPUConfiguration(e) => write!(
+                f,
+                "Error configuring the floating point related registers: {e:?}"
+            ),
+            GuestMemoryMmap(e) => write!(f, "Guest memory error: {e:?}"),
+            HypervisorUnavailable(e) => {
+                write!(f, "The Windows Hypervisor Platform is unavailable: {e}")
+            }
+            CreateEmulator(e) => write!(f, "Cannot create the instruction emulator: {e}"),
+            MSRSConfiguration(e) => write!(f, "Error configuring the MSR registers: {e:?}"),
+            REGSConfiguration(e) => {
+                write!(f, "Error configuring the general purpose registers: {e:?}")
+            }
+            SREGSConfiguration(e) => write!(f, "Error configuring the special registers: {e:?}"),
+            SetUserMemoryRegion(e) => write!(f, "Cannot set the memory regions: {e}"),
+            VcpuChannelClosed => write!(f, "vCPU response channel closed"),
+            VcpuCreate(e) => write!(f, "Cannot create the virtual processor: {e}"),
+            VcpuCountNotInitialized => write!(f, "vCPU count is not initialized"),
+            VcpuRun(e) => write!(f, "Cannot run the VCPUs: {e}"),
+            VcpuSpawn(e) => write!(f, "Cannot spawn a new vCPU thread: {e}"),
+            VcpuEmulation(e) => write!(f, "Cannot emulate the intercepted instruction: {e}"),
+            VcpuUnhandledWhpExit(reason) => {
+                write!(f, "Unexpected WHvRunVirtualProcessor exit reason: {reason}")
+            }
+            VcpuRegisterAccess(e) => write!(f, "Cannot access a vCPU register: {e}"),
+            VmSetup(e) => write!(f, "Cannot configure the microvm: {e}"),
+        }
+    }
+}
+
+pub type Result<T> = result::Result<T, Error>;
+
+/// A wrapper around creating and using a WHP partition.
+pub struct Vm {
+    whp_vm: Arc<WhpVm>,
+
+    // Keeping the guest memory alive here is load-bearing, not bookkeeping.
+    // `WHvMapGpaRange` records raw host pointers into these mappings, and the
+    // partition keeps dereferencing them for as long as it exists. `Vmm` stores
+    // `guest_memory` before `vm`, and Rust drops struct fields in declaration
+    // order, so without this clone the backing pages would be unmapped while
+    // the partition still referenced them.
+    guest_memory: Option<GuestMemoryMmap>,
+}
+
+impl Vm {
+    /// Creates and finalises a WHP partition sized for `vcpu_count` processors.
+    ///
+    /// Unlike `KVM_CREATE_VM` and `hv_vm_create`, WHP needs the processor count
+    /// *before* the partition is usable: `WHvSetupPartition` locks the
+    /// configuration in, and vCPUs cannot be created before it nor the count
+    /// changed after it. That is why this takes an argument the other two
+    /// backends' `Vm::new` does not.
+    pub fn new(vcpu_count: u8) -> Result<Self> {
+        // Fail with "no hypervisor" rather than an opaque HRESULT from
+        // WHvCreatePartition when the feature is simply not enabled.
+        whp::check_hypervisor().map_err(Error::HypervisorUnavailable)?;
+
+        let whp_vm = WhpVm::new(u32::from(vcpu_count)).map_err(Error::VmSetup)?;
+
+        Ok(Vm {
+            whp_vm: Arc::new(whp_vm),
+            guest_memory: None,
+        })
+    }
+
+    /// The partition, for the pieces that talk to WHP directly — currently the
+    /// IOAPIC backend, which needs it to issue `WHvRequestInterrupt`.
+    pub fn whp_vm(&self) -> &Arc<WhpVm> {
+        &self.whp_vm
+    }
+
+    /// Maps every guest memory region into the partition's physical address
+    /// space.
+    pub fn memory_init(&mut self, guest_mem: &GuestMemoryMmap) -> Result<()> {
+        for region in guest_mem.iter() {
+            // Safe to unwrap: the address comes from the region itself.
+            let host_addr = guest_mem.get_host_address(region.start_addr()).unwrap();
+            debug!(
+                "Guest memory host_addr={:x?} guest_addr={:x?} len={:x?}",
+                host_addr,
+                region.start_addr().raw_value(),
+                region.len()
+            );
+
+            // SAFETY: `host_addr` points into a live mapping owned by
+            // `guest_mem`, of at least `region.len()` bytes, and the clone
+            // stored below keeps that mapping alive for as long as the
+            // partition can reach it.
+            unsafe {
+                self.whp_vm
+                    .map_memory(
+                        host_addr as *mut std::ffi::c_void,
+                        region.start_addr().raw_value(),
+                        region.len(),
+                    )
+                    .map_err(Error::SetUserMemoryRegion)?;
+            }
+        }
+
+        self.guest_memory = Some(guest_mem.clone());
+
+        Ok(())
+    }
+}
+
+/// Encapsulates configuration parameters for the guest vCPUS.
+#[derive(Debug, Eq, PartialEq)]
+pub struct VcpuConfig {
+    /// Number of guest VCPUs.
+    pub vcpu_count: u8,
+    /// Enable hyperthreading in the CPUID configuration.
+    pub ht_enabled: bool,
+    /// CPUID template to use.
+    pub cpu_template: Option<CpuFeaturesTemplate>,
+}
+
+/// A wrapper around creating and using a WHP-based vCPU.
+pub struct Vcpu {
+    id: u8,
+
+    // Created eagerly in `new_x86_64` so that `configure_x86_64` can write the
+    // boot register state before the guest starts, then moved onto the vCPU
+    // thread by `run`. WHP allows a virtual processor to be created on one
+    // thread and run on another; what it does not allow is two threads running
+    // the same processor at once, which the `Option`-take enforces structurally.
+    whp_vcpu: Option<WhpVcpu>,
+
+    mmio_bus: Option<devices::Bus>,
+    io_bus: devices::Bus,
+
+    // The emulator's memory callback needs to reach guest RAM for the operands
+    // of an intercepted instruction that do not themselves fault; see
+    // `windows::emulator::memory_callback`.
+    guest_memory: GuestMemoryMmap,
+
+    exit_evt: EventFd,
+
+    // The receiving end of the responses channel which will be given to the handler.
+    response_receiver: Option<Receiver<VcpuResponse>>,
+    // The transmitting end of the responses channel owned by the vcpu side.
+    response_sender: Sender<VcpuResponse>,
+}
+
+impl Vcpu {
+    /// Registers a signal handler to kick a running vCPU.
+    ///
+    /// Nothing to do on Windows: there are no signals, and the equivalent
+    /// "break this vCPU out of the hypervisor" primitive is
+    /// `WHvCancelRunVirtualProcessor`, which is called directly on the
+    /// partition rather than through a handler. Kept so that the cross-platform
+    /// call in `Vmm::start_vcpus` stays uniform.
+    pub fn register_kick_signal_handler() {}
+
+    /// Constructs a new vCPU within `vm`.
+    ///
+    /// # Arguments
+    ///
+    /// * `id` - Represents the CPU number between [0, max vcpus).
+    /// * `vm` - The partition this vCPU will belong to.
+    /// * `io_bus` - The io-bus used to access port-io devices.
+    /// * `guest_memory` - Guest RAM, for the instruction emulator's memory callback.
+    /// * `exit_evt` - An `EventFd` that will be written into when this vcpu exits.
+    pub fn new_x86_64(
+        id: u8,
+        vm: &Vm,
+        io_bus: devices::Bus,
+        guest_memory: GuestMemoryMmap,
+        exit_evt: EventFd,
+    ) -> Result<Self> {
+        let whp_vcpu =
+            WhpVcpu::new(vm.whp_vm().clone(), u32::from(id)).map_err(Error::VcpuCreate)?;
+        let (response_sender, response_receiver) = unbounded();
+
+        Ok(Vcpu {
+            id,
+            whp_vcpu: Some(whp_vcpu),
+            mmio_bus: None,
+            io_bus,
+            guest_memory,
+            exit_evt,
+            response_receiver: Some(response_receiver),
+            response_sender,
+        })
+    }
+
+    /// Returns the cpu index as seen by the guest OS.
+    pub fn cpu_index(&self) -> u8 {
+        self.id
+    }
+
+    /// Sets a MMIO bus for this vcpu.
+    pub fn set_mmio_bus(&mut self, mmio_bus: devices::Bus) {
+        self.mmio_bus = Some(mmio_bus);
+    }
+
+    /// Configures a x86_64 specific vcpu and should be called once per vcpu.
+    ///
+    /// # Arguments
+    ///
+    /// * `guest_mem` - The guest memory used by this microvm.
+    /// * `kernel_start_addr` - Offset from `guest_mem` at which the kernel starts.
+    /// * `vcpu_config` - The machine configuration of this microvm.
+    /// * `kernel_boot` - Whether we are booting a kernel directly (as opposed to firmware).
+    pub fn configure_x86_64(
+        &mut self,
+        guest_mem: &GuestMemoryMmap,
+        kernel_start_addr: GuestAddress,
+        vcpu_config: &VcpuConfig,
+        kernel_boot: bool,
+    ) -> Result<()> {
+        // The KVM path calls `filter_cpuid` here to normalise the CPUID
+        // topology (and apply T2/C3). WHP gives us no way to do that — see the
+        // module-level notes — so an explicitly requested template is refused
+        // rather than silently dropped, which would hand the guest a CPU that
+        // does not match what the caller asked for.
+        if let Some(template) = vcpu_config.cpu_template {
+            return Err(Error::CpuTemplateUnsupported(template));
+        }
+
+        let whp_vcpu = self
+            .whp_vcpu
+            .as_ref()
+            .expect("vCPU was already moved to its thread");
+
+        if kernel_boot {
+            arch::x86_64::msr::setup_msrs(whp_vcpu).map_err(Error::MSRSConfiguration)?;
+            arch::x86_64::regs::setup_regs(whp_vcpu, kernel_start_addr.raw_value())
+                .map_err(Error::REGSConfiguration)?;
+            arch::x86_64::regs::setup_sregs(guest_mem, whp_vcpu)
+                .map_err(Error::SREGSConfiguration)?;
+
+            // Two steps the KVM path takes that are deliberately absent:
+            //
+            // * `setup_fpu`. Firecracker loads the post-`FNINIT` x87 state
+            //   (FCW=0x037f, MXCSR=0x1f80) because KVM's initial FPU state is
+            //   not guaranteed to be the architectural reset state. A WHP
+            //   virtual processor starts at architectural reset, and the Linux
+            //   boot path runs `fninit` itself before using the FPU, so there is
+            //   nothing to correct. Writing it anyway would mean composing
+            //   `WHV_X64_FP_CONTROL_STATUS_REGISTER` by hand for no benefit.
+            //
+            // * `interrupts::set_lint`, which programs LAPIC LVT0 as ExtINT and
+            //   LVT1 as NMI for virtual-wire mode with an 8259 PIC. WHP emulates
+            //   the LAPIC itself and libkrun routes device interrupts through
+            //   the IOAPIC, so there is no PIC to chain to. If a guest ever
+            //   needs the LVT entries programmed, the way in is
+            //   `WHvGetVirtualProcessorInterruptControllerState`, which is not
+            //   currently bound.
+        }
+
+        Ok(())
+    }
+
+    /// Moves the vcpu to its own thread and constructs a VcpuHandle.
+    /// The handle can be used to control the remote vcpu.
+    pub fn start_threaded(mut self) -> Result<VcpuHandle> {
+        let response_receiver = self.response_receiver.take().unwrap();
+        let (init_sender, init_receiver) = unbounded();
+
+        let vcpu_thread = thread::Builder::new()
+            .name(format!("fc_vcpu {}", self.cpu_index()))
+            .spawn(move || {
+                self.run(init_sender);
+            })
+            .map_err(Error::VcpuSpawn)?;
+
+        // Block until the thread has taken ownership of the virtual processor
+        // and built its emulator, so that a failure there surfaces here rather
+        // than as a guest that never starts.
+        init_receiver
+            .recv()
+            .expect("vCPU thread exited before reporting readiness")?;
+
+        Ok(VcpuHandle::new(response_receiver, vcpu_thread))
+    }
+
+    /// Runs the guest until the next exit and services it.
+    fn run_emulation(
+        &self,
+        whp_vcpu: &mut WhpVcpu,
+        emulator: &WhpEmulator,
+    ) -> Result<VcpuEmulation> {
+        let exit = whp_vcpu.run().map_err(Error::VcpuRun)?;
+
+        match exit {
+            // The guest touched an I/O port or an unmapped physical address.
+            // Both are handed to the instruction emulator, which decodes the
+            // access, calls back into `windows::emulator` to perform it, writes
+            // the result into the guest's registers and advances RIP.
+            VcpuExitReason::IoPortAccess => {
+                let ctx = self.emulator_context(whp_vcpu);
+                // SAFETY: all three pointers are valid for the duration of the
+                // call — `ctx` is a live local, and the two exit contexts point
+                // into `whp_vcpu`, which outlives this statement.
+                unsafe {
+                    emulator.try_io_emulation(
+                        ctx.as_ptr(),
+                        whp_vcpu.vp_exit_context(),
+                        whp_vcpu.io_port_access_context(),
+                    )
+                }
+                .map_err(Error::VcpuEmulation)?;
+                Ok(VcpuEmulation::Handled)
+            }
+            VcpuExitReason::MemoryAccess => {
+                let ctx = self.emulator_context(whp_vcpu);
+                // SAFETY: as above.
+                unsafe {
+                    emulator.try_mmio_emulation(
+                        ctx.as_ptr(),
+                        whp_vcpu.vp_exit_context(),
+                        whp_vcpu.memory_access_context(),
+                    )
+                }
+                .map_err(Error::VcpuEmulation)?;
+                Ok(VcpuEmulation::Handled)
+            }
+            VcpuExitReason::Halt => Ok(self.handle_halt(whp_vcpu)),
+            // Someone called `WHvCancelRunVirtualProcessor`. Nothing to do:
+            // whatever prompted the cancellation is observed by the caller on
+            // the next trip round the loop.
+            VcpuExitReason::Canceled => {
+                debug!("vCPU {} run canceled", self.id);
+                Ok(VcpuEmulation::Handled)
+            }
+            VcpuExitReason::CpuidAccess => {
+                // Unreachable as the partition stands: without
+                // `WHvPartitionPropertyCodeCpuidExitList`, WHP answers CPUID
+                // itself from its defaults plus the `CpuidResultList` installed
+                // in `WhpVm::configure_partition`. Handled anyway, by replaying
+                // the default result WHP computed, so that adding an exit list
+                // later cannot turn into a hang.
+                let info = whp_vcpu.cpuid_exit_info();
+                debug!(
+                    "vCPU {} CPUID leaf 0x{:x} subleaf 0x{:x}",
+                    self.id, info.leaf, info.subleaf
+                );
+                whp_vcpu
+                    .complete_cpuid(
+                        info.default_eax,
+                        info.default_ebx,
+                        info.default_ecx,
+                        info.default_edx,
+                    )
+                    .map_err(Error::VcpuRegisterAccess)?;
+                Ok(VcpuEmulation::Handled)
+            }
+            VcpuExitReason::MsrAccess => self.handle_msr_access(whp_vcpu),
+            VcpuExitReason::InterruptWindow => {
+                // We asked to be told when the guest could next take an
+                // interrupt. We do not queue interrupts ourselves — the IOAPIC
+                // backend hands them straight to `WHvRequestInterrupt`, which
+                // queues them in the emulated LAPIC — so there is nothing to
+                // deliver here; clearing the request stops WHP exiting on every
+                // subsequent `STI`.
+                whp_vcpu
+                    .clear_interrupt_window()
+                    .map_err(Error::VcpuRegisterAccess)?;
+                Ok(VcpuEmulation::Handled)
+            }
+            // The x86 equivalent of KVM_EXIT_SHUTDOWN: a triple fault, or an
+            // exception the guest cannot handle. The guest is not recoverable.
+            VcpuExitReason::UnrecoverableException => {
+                error!(
+                    "vCPU {} took an unrecoverable exception at rip=0x{:x}",
+                    self.id,
+                    whp_vcpu.exit_rip()
+                );
+                Ok(VcpuEmulation::Stopped)
+            }
+            VcpuExitReason::InvalidVpRegisterValue => {
+                error!(
+                    "vCPU {} has an invalid register state at rip=0x{:x}",
+                    self.id,
+                    whp_vcpu.exit_rip()
+                );
+                Err(Error::VcpuUnhandledWhpExit(0))
+            }
+            VcpuExitReason::UnsupportedFeature => {
+                error!(
+                    "vCPU {} used a feature the partition does not support, at rip=0x{:x}",
+                    self.id,
+                    whp_vcpu.exit_rip()
+                );
+                Err(Error::VcpuUnhandledWhpExit(0))
+            }
+            VcpuExitReason::Unknown(reason) => {
+                error!("vCPU {} unexpected exit reason {reason}", self.id);
+                Err(Error::VcpuUnhandledWhpExit(reason))
+            }
+        }
+    }
+
+    fn emulator_context<'a>(&'a self, whp_vcpu: &'a WhpVcpu) -> EmulatorContext<'a> {
+        EmulatorContext {
+            vcpu: whp_vcpu,
+            vcpu_id: u64::from(self.id),
+            io_bus: &self.io_bus,
+            mmio_bus: self.mmio_bus.as_ref(),
+            guest_memory: &self.guest_memory,
+        }
+    }
+
+    /// Decides what a `HLT` exit means.
+    ///
+    /// The distinction is RFLAGS.IF as it stood when the guest halted. With
+    /// interrupts masked (`cli; hlt`) nothing can ever wake the processor, so
+    /// the guest has stopped for good — this is the case the KVM backend sees
+    /// as `KVM_EXIT_HLT` and treats as a shutdown. With interrupts enabled
+    /// (`sti; hlt`) this is an ordinary idle and the guest must be resumed once
+    /// an interrupt arrives.
+    fn handle_halt(&self, whp_vcpu: &WhpVcpu) -> VcpuEmulation {
+        if whp_vcpu.exit_rflags() & RFLAGS_IF == 0 {
+            info!(
+                "vCPU {} halted with interrupts disabled at rip=0x{:x}; treating as shutdown",
+                self.id,
+                whp_vcpu.exit_rip()
+            );
+            VcpuEmulation::Stopped
+        } else {
+            VcpuEmulation::Halted
+        }
+    }
+
+    /// Parks an idle vCPU before re-entering the guest.
+    ///
+    /// UNVERIFIED AGAINST HARDWARE. Two readings of the WHP contract are
+    /// possible and this code has never run:
+    ///
+    /// 1. `WHvRunVirtualProcessor` returns `X64Halt` and leaves the processor
+    ///    halted, so re-entering immediately would spin at 100% CPU.
+    /// 2. `WHvRunVirtualProcessor` blocks internally while the processor is
+    ///    halted and only returns once an interrupt lands or the call is
+    ///    cancelled — which is what the note on `WhpVm::cancel_vcpu` ("required
+    ///    to wake a vCPU that is blocked in HLT") suggests.
+    ///
+    /// A short sleep before re-entry is correct under both: under (2) it never
+    /// happens, and under (1) it turns a spin into a bounded-rate poll. What it
+    /// costs under (1) is up to `HALT_POLL_INTERVAL` of extra latency on a
+    /// device interrupt delivered to an idle guest.
+    ///
+    /// The event-driven version needs the injecting side to be able to wake
+    /// this thread. `WhpIoapicBackend` holds the partition and could call
+    /// `WhpVm::cancel_vcpu`, but it does not know which vCPUs are parked here;
+    /// closing that gap is follow-up work, deliberately not guessed at now.
+    fn wait_for_interrupt(&self) {
+        thread::sleep(HALT_POLL_INTERVAL);
+    }
+
+    /// Services an MSR the partition did not handle.
+    ///
+    /// `WhpVm::configure_partition` sets `X64MsrExitBitmap` bit 0
+    /// (`UnhandledMsrs`), so anything WHP does not model itself lands here
+    /// rather than failing inside the hypervisor.
+    ///
+    /// The policy is KVM's `ignore_msrs=1`: reads return zero, writes are
+    /// dropped, both advance past the instruction. The architecturally correct
+    /// answer is `#GP`, and KVM's default is to inject one — but WHP exposes no
+    /// exception-injection call in these bindings (`WHvRequestInterrupt` carries
+    /// external interrupts only; a `#GP` would have to be composed into
+    /// `WHvX64RegisterPendingEvent`). Faulting the guest is the more faithful
+    /// behaviour and should replace this once that register is bound; until
+    /// then, ignoring is the option that boots rather than the option that is
+    /// right, and it is logged so the difference is visible.
+    fn handle_msr_access(&self, whp_vcpu: &WhpVcpu) -> Result<VcpuEmulation> {
+        let info = whp_vcpu.msr_exit_info();
+
+        if info.is_write {
+            debug!(
+                "vCPU {} wrote unhandled MSR 0x{:x} (eax=0x{:x} edx=0x{:x}); ignoring",
+                self.id, info.msr_number, info.rax, info.rdx
+            );
+            whp_vcpu.advance_rip().map_err(Error::VcpuRegisterAccess)?;
+        } else {
+            debug!(
+                "vCPU {} read unhandled MSR 0x{:x}; returning 0",
+                self.id, info.msr_number
+            );
+            whp_vcpu
+                .complete_msr_read(0, 0)
+                .map_err(Error::VcpuRegisterAccess)?;
+        }
+
+        Ok(VcpuEmulation::Handled)
+    }
+
+    /// Main loop of the vCPU thread.
+    fn run(&mut self, init_sender: Sender<Result<()>>) {
+        let mut whp_vcpu = match self.whp_vcpu.take() {
+            Some(vcpu) => vcpu,
+            None => {
+                let _ = init_sender.send(Err(Error::VcpuCountNotInitialized));
+                return;
+            }
+        };
+
+        // One emulator per vCPU: the handle carries per-instruction decode
+        // state, so sharing one across threads would corrupt concurrent
+        // emulations.
+        let emulator = match WhpEmulator::new(emulator::callbacks()) {
+            Ok(emulator) => emulator,
+            Err(e) => {
+                let _ = init_sender.send(Err(Error::CreateEmulator(e)));
+                return;
+            }
+        };
+
+        if init_sender.send(Ok(())).is_err() {
+            // The spawning thread is gone; there is nobody left to run for.
+            return;
+        }
+
+        loop {
+            match self.run_emulation(&mut whp_vcpu, &emulator) {
+                // Emulation ran successfully, continue.
+                Ok(VcpuEmulation::Handled) => (),
+                // The guest is idle; park before re-entering.
+                Ok(VcpuEmulation::Halted) => self.wait_for_interrupt(),
+                // The guest was rebooted or halted for good.
+                Ok(VcpuEmulation::Stopped) => {
+                    self.exit(FC_EXIT_CODE_OK);
+                    break;
+                }
+                // Emulation errors lead to vCPU exit.
+                Err(e) => {
+                    error!("vCPU {} exiting: {e}", self.id);
+                    self.exit(FC_EXIT_CODE_GENERIC_ERROR);
+                    break;
+                }
+            }
+        }
+    }
+
+    fn exit(&mut self, exit_code: u8) {
+        self.response_sender
+            .send(VcpuResponse::Exited(exit_code))
+            .expect("failed to send Exited status");
+
+        if let Err(e) = self.exit_evt.write(1) {
+            error!("Failed signaling vcpu exit event: {e}");
+        }
+    }
+}
+
+#[derive(Debug, Eq, PartialEq)]
+/// List of responses that the Vcpu reports.
+pub enum VcpuResponse {
+    /// Vcpu is stopped.
+    Exited(u8),
+}
+
+/// Wrapper over Vcpu that hides the underlying interactions with the Vcpu thread.
+///
+/// Thinner than its KVM and HVF counterparts because there is no event channel:
+/// pause/resume is not implemented on WHP (see the module-level notes), so the
+/// only traffic is the vCPU reporting its own exit.
+pub struct VcpuHandle {
+    response_receiver: Receiver<VcpuResponse>,
+}
+
+impl VcpuHandle {
+    pub fn new(
+        response_receiver: Receiver<VcpuResponse>,
+        _vcpu_thread: thread::JoinHandle<()>,
+    ) -> Self {
+        Self { response_receiver }
+    }
+
+    pub fn response_receiver(&self) -> &Receiver<VcpuResponse> {
+        &self.response_receiver
+    }
+}
+
+enum VcpuEmulation {
+    Handled,
+    Halted,
+    Stopped,
+}
