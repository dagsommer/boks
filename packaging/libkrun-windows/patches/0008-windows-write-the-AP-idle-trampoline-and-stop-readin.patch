+/// The idle loop APs execute until the BSP starts them.
+///
+/// ```text
+///   0x1000:  fa        cli
+///   0x1001:  f4        hlt
+///   0x1002:  eb fc     jmp 0x1000
+/// ```
+///
+/// The `jmp` displacement is relative to the address of the *next* instruction
+/// (0x1004), so -4 lands back on the `cli`.
+///
+/// `cli` before `hlt` is deliberate. An AP must not act on device interrupts
+/// before the BSP has started it; the events that legitimately wake it here are
+/// INIT and SIPI, which wake a halted processor regardless of RFLAGS.IF. The
+/// `jmp` back exists for the spurious-wakeup case, and to re-arm the halt if
+/// the processor is resumed without having been sent a SIPI.
+const AP_TRAMPOLINE_CODE: [u8; 4] = [0xfa, 0xf4, 0xeb, 0xfc];
+
+/// Writes the AP idle trampoline into guest memory.
+///
+/// [`setup_regs`] parks every non-boot vCPU at [`AP_TRAMPOLINE_START`], so
+/// something has to put instructions there. Without this the APs would execute
+/// whatever happens to be at guest physical 0x1000 — zeroed memory, i.e. a run
+/// of `add [bx+si], al` — and wander off into a triple fault.
+///
+/// The KVM path needs no counterpart: `KVM_ARM_VCPU_POWER_OFF` has no x86
+/// equivalent, but KVM starts x86 APs in the INIT-received (wait-for-SIPI)
+/// state, so they never execute anything until the BSP starts them. WHP starts
+/// every virtual processor runnable, so the wait has to be expressed as code.
+pub fn setup_ap_trampoline(mem: &GuestMemoryMmap) -> Result<()> {
+    mem.write_slice(&AP_TRAMPOLINE_CODE, GuestAddress(AP_TRAMPOLINE_START))
+        .map_err(|_| Error::WriteApTrampoline)
+}
