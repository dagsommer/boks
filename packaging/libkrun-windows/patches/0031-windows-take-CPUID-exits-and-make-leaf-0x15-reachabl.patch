         Self::set_property(handle, WHvPartitionPropertyCodeExtendedVmExits, |p| {
-            p.ExtendedVmExits.AsUINT64 = 0b10; // bit 1 = X64MsrExit
+            p.ExtendedVmExits.AsUINT64 = 0b11; // bit 0 = X64CpuidExit, bit 1 = X64MsrExit
         })?;
 
+        // The leaves the VMM rewrites on each exit, in `normalize_cpuid`.
+        //
+        // `CpuidResultList` (used further down for the purely synthetic leaves)
+        // is a *whole-leaf* override: it replaces all four registers with
+        // constants chosen before the partition starts. That is exactly right
+        // for a leaf invented wholesale, and exactly wrong for these two, each
+        // of which has to be WHP's own answer with a few bits changed:
+        //
+        // * `0x0` — the vendor string in EBX/ECX/EDX must survive untouched;
+        //   only EAX (the maximum standard leaf) is raised, so that the guest
+        //   goes on to read the synthetic 0x15 installed below. AMD hosts
+        //   report a maximum of 0xD, and Linux reads 0x15 only when
+        //   `cpuid_level` is at least 0x15, which is what puts the leaf out of
+        //   reach there today.
+        // * `0x1` — ECX and EDX carry WHP's *filtered* feature set, i.e. the
+        //   features this partition can actually use. Rebuilding the leaf from
+        //   a host `__cpuid(1)` would re-advertise whatever WHP masked off and
+        //   hand the guest instructions the partition cannot execute.
+        //
+        // Both leaves are read a handful of times during guest boot and never
+        // on a hot path, so trapping them costs nothing measurable. Topology
+        // (0xB/0x1F) is deliberately *not* trapped: nothing in the timekeeping
+        // path depends on it, and rewriting it is a change to AP bring-up that
+        // cannot be justified by the bug this list exists to fix.
+        const CPUID_EXIT_LEAVES: [u32; 2] = [0x0, 0x1];
+        let hr = unsafe {
+            WHvSetPartitionProperty(
+                handle,
+                WHvPartitionPropertyCodeCpuidExitList,
+                CPUID_EXIT_LEAVES.as_ptr().cast(),
+                std::mem::size_of_val(&CPUID_EXIT_LEAVES) as u32,
+            )
+        };
+        if hr != S_OK {
+            return Err(Error::SetPartitionProperty(hr));
+        }
