-    /// Detect the host TSC frequency in Hz.
-    /// Tries CPUID 0x15, then 0x16 (Intel), then falls back to measuring
-    /// via RDTSC over a short sleep (works on AMD and all other x86_64).
+    /// Detect the rate, in Hz, at which the guest's TSC advances.
+    ///
+    /// Sources are tried in descending order of authority:
+    ///
+    /// 1. `WHvCapabilityCodeProcessorClockFrequency`. This is the platform's
+    ///    own statement of the rate it runs the partition's TSC at, which is
+    ///    the number the guest actually needs; everything below is an
+    ///    inference about the *host* that happens to usually match.
+    /// 2. CPUID 0x15 / 0x16 on the host, when the host CPU reports them
+    ///    (Intel; AMD generally does not).
+    /// 3. Measuring RDTSC against QPC over a 10 ms window.
+    ///
+    /// The capability is range-checked before it is believed: a value outside
+    /// any plausible clock rate is more likely to be a field this build of WHP
+    /// does not populate than a real frequency, and falling through to the
+    /// measurement is better than handing the guest a nonsense TSC rate that
+    /// would scale every timeout it computes.
     fn detect_tsc_frequency() -> u64 {
+        // 100 MHz to 100 GHz. Wide enough not to reject any real machine,
+        // narrow enough to catch a zero or an uninitialised field.
+        const MIN_PLAUSIBLE_TSC_HZ: u64 = 100_000_000;
+        const MAX_PLAUSIBLE_TSC_HZ: u64 = 100_000_000_000;
+
+        let mut capability: mem::MaybeUninit<WHV_CAPABILITY> = mem::MaybeUninit::uninit();
+        let mut written_size = 0;
+        let reported = unsafe {
+            let hr = WHvGetCapability(
+                WHvCapabilityCodeProcessorClockFrequency,
+                capability.as_mut_ptr().cast(),
+                mem::size_of::<WHV_CAPABILITY>() as u32,
+                &mut written_size,
+            );
+
+            if hr == S_OK {
+                capability.assume_init().ProcessorClockFrequency
+            } else {
+                debug!("WHvCapabilityCodeProcessorClockFrequency unavailable: HRESULT 0x{hr:08x}");
+                0
+            }
+        };
+
+        if (MIN_PLAUSIBLE_TSC_HZ..=MAX_PLAUSIBLE_TSC_HZ).contains(&reported) {
+            debug!("TSC frequency from WHP: {reported} Hz");
+            return reported;
+        }
+        if reported != 0 {
+            debug!("WHP reported an implausible processor clock frequency {reported} Hz; ignoring");
+        }
+
         unsafe {
             // Leaf 0 returns the maximum supported standard leaf in EAX.
             // leaves 0x15 and 0x16 may not be supported (like in non-Intel hardware (like AMD)
