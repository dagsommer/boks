         // 0x40000003 — Feature identification (Hyper-V TLFS §2.4)
+        //
+        // This leaf must advertise only what this backend actually backs.
+        // Linux reads it as `ms_hyperv.features` and each bit switches on code
+        // that reads a synthetic MSR; anything advertised but unimplemented
+        // becomes an MSR read that `Vcpu::handle_msr_access` answers with 0,
+        // which is indistinguishable from a stopped clock.
+        //
+        // Deliberately *not* advertised:
+        //
+        // * `ACCESS_REF_COUNTER` (bit 1) and `ACCESS_REF_TSC` (bit 9). These
+        //   gate `hv_init_clocksource()` (drivers/clocksource/hyperv_timer.c),
+        //   which registers Hyper-V clocksources that read the reference
+        //   counter at MSR 0x40000020. A write to enable the reference-TSC
+        //   page (MSR 0x40000021) that this backend drops leaves the page
+        //   invalid, and the read path then falls back to that same MSR. A
+        //   clocksource wired to an MSR that always reads 0 is a *worse*
+        //   failure than having no paravirtualised clocksource: it is frozen
+        //   and it outranks the TSC. WHP may well implement both MSRs — the
+        //   matching `SyntheticProcessorFeaturesBanks` bits are set — but that
+        //   is unverified, and the guest does not need them.
+        //
+        // `ACCESS_TSC_INVARIANT` (bit 15) *is* advertised, and is the one bit
+        // here that changes timekeeping for the better. Without it,
+        // `ms_hyperv_init_platform()` ends with
+        //
+        //     if (!(ms_hyperv.features & HV_ACCESS_TSC_INVARIANT))
+        //             mark_tsc_unstable("running on Hyper-V");
+        //
+        // and an unstable sched_clock is precisely what arms the
+        // `sched_clock_local()` clamp that pins every printk timestamp to
+        // `tick_gtod + TICK_NSEC`. The claim it makes is true here: the
+        // partition is configured for an invariant TSC, which is also what
+        // CPUID 0x80000007 EDX bit 8 below reports. The MSR write the guest
+        // makes in response (0x40000118) only asks the hypervisor to expose
+        // that same CPUID bit, so dropping the write costs nothing.
         const ACCESS_VP_RUNTIME: u32 = 1 << 0;
-        const ACCESS_REF_COUNTER: u32 = 1 << 1;
         const ACCESS_HYPERCALLS: u32 = 1 << 5;
         const ACCESS_VP_INDEX: u32 = 1 << 6;
-        const ACCESS_REF_TSC: u32 = 1 << 9;
         const ACCESS_FREQ_REGS: u32 = 1 << 11;
+        const ACCESS_TSC_INVARIANT: u32 = 1 << 15;
         cpuid_results.push(WHV_X64_CPUID_RESULT {
             Function: 0x40000003,
             Reserved: [0; 3],
             Eax: ACCESS_VP_RUNTIME
-                | ACCESS_REF_COUNTER
                 | ACCESS_HYPERCALLS
                 | ACCESS_VP_INDEX
-                | ACCESS_REF_TSC
-                | ACCESS_FREQ_REGS,
+                | ACCESS_FREQ_REGS
+                | ACCESS_TSC_INVARIANT,
             Ebx: 0,
             Ecx: 0,
             Edx: 0,
@@ -527,10 +602,55 @@ impl WhpVm {
