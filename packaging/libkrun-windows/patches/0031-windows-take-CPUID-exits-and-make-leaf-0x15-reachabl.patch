             VcpuExitReason::CpuidAccess => {
-                // Unreachable as the partition stands: without
-                // `WHvPartitionPropertyCodeCpuidExitList`, WHP answers CPUID
-                // itself from its defaults plus the `CpuidResultList` installed
-                // in `WhpVm::configure_partition`. Handled anyway, by replaying
-                // the default result WHP computed, so that adding an exit list
-                // later cannot turn into a hang.
+                // Reached for the leaves named in
+                // `WHvPartitionPropertyCodeCpuidExitList`, which
+                // `WhpVm::configure_partition` sets to the leaves that must be
+                // WHP's own answer with a few bits changed. Every other leaf is
+                // still answered by WHP itself, from its defaults plus the
+                // whole-leaf `CpuidResultList` overrides.
                 let info = whp_vcpu.cpuid_exit_info();
+                let (eax, ebx, ecx, edx) = normalize_cpuid(&info);
                 debug!(
-                    "vCPU {} CPUID leaf 0x{:x} subleaf 0x{:x}",
+                    "vCPU {} CPUID leaf 0x{:x} subleaf 0x{:x} -> {eax:#x} {ebx:#x} {ecx:#x} {edx:#x}",
                     self.id, info.leaf, info.subleaf
                 );
                 whp_vcpu
-                    .complete_cpuid(
-                        info.default_eax,
-                        info.default_ebx,
-                        info.default_ecx,
-                        info.default_edx,
-                    )
+                    .complete_cpuid(eax, ebx, ecx, edx)
                     .map_err(Error::VcpuRegisterAccess)?;
                 Ok(VcpuEmulation::Handled)
             }
