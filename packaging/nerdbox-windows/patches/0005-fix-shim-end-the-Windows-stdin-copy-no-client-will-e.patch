diff --git a/internal/shim/task/io_copystreams_windows.go b/internal/shim/task/io_copystreams_windows.go
index 09642b6..fedb2fa 100644
--- a/internal/shim/task/io_copystreams_windows.go
+++ b/internal/shim/task/io_copystreams_windows.go
@@ -65,6 +65,77 @@ func (w *writeErrRecorder) Write(p []byte) (int, error) {
 	return n, err
 }
 
+// stdinClient tracks the client-side stdin connection the copy goroutine is
+// currently reading from, so that stdinEOF can end a read that is already in
+// flight.
+//
+// Nothing else can end it. Unlike a POSIX FIFO -- where the host holds its own
+// O_WRONLY reference and dropping it lets the FIFO reach EOF -- a named pipe
+// connection ends only when the peer disconnects, and containerd's client-side
+// stdio never disconnects this one: pkg/cio/io_windows.go's copyIO leaves the
+// accepted connection out of the cio's closers (only the *listener* is closed by
+// Close) and its cio has no cancel func at all, so the connection stays open,
+// held by a goroutine blocked copying an os.Stdin that a console never EOFs.
+// The Unix build's cio does close its stdin FIFO handle in cancel, which is why
+// this only bites on Windows.
+//
+// Closing the connection cannot truncate stdin. The copy goroutine reads in a
+// tight loop, so it is blocked in a read only when the pipe's buffer is empty:
+// every byte the client wrote before it declared stdin finished has already been
+// relayed to the guest. A byte racing the close would be one written after
+// CloseIO, which the client has by then promised not to send.
+type stdinClient struct {
+	mu sync.Mutex
+	// conn is the connection currently being read, nil between a client
+	// disconnecting and the next one attaching.
+	conn io.Closer
+	// eof records that stdinEOF has been called, so a connection attached
+	// after it is closed rather than read.
+	eof bool
+	// closed records that requestEOF actually closed a connection, which is
+	// what distinguishes "the read ended because we ended it" from a real
+	// error worth logging.
+	closed bool
+}
+
+// requestEOF records that no further stdin will be relayed and ends any read in
+// flight by closing the connection under it. Idempotent: go-winio's Close is,
+// and the flags only ever move one way.
+func (c *stdinClient) requestEOF() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.eof = true
+	if c.conn != nil {
+		c.conn.Close()
+		c.conn = nil
+		c.closed = true
+	}
+}
+
+// attach makes conn the connection to read next, reporting false -- and closing
+// conn -- if stdinEOF has already fired. Without that check a redial that
+// completed just as stdinEOF cancelled it would hand the loop a fresh connection
+// to block on forever, which is the stall this type exists to end.
+func (c *stdinClient) attach(conn io.Closer) bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.eof {
+		conn.Close()
+		c.closed = true
+		return false
+	}
+	c.conn = conn
+	return true
+}
+
+// endedByEOF reports whether requestEOF closed a connection, i.e. whether the
+// copy error the caller is holding is one we caused.
+func (c *stdinClient) endedByEOF() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.closed
+}
+
 // copyStreams returns a stdinEOF function and a stdinDone channel for the
 // stdin pipe (both nil when stdin is empty).
 //
@@ -88,6 +159,14 @@ func (w *writeErrRecorder) Write(p []byte) (int, error) {
 // disconnect (or the current one, if it already happened) deliver EOF to
 // the guest via CloseWrite.
 //
+// stdinEOF also disconnects the client itself, by closing the connection
+// the copy is reading (stdinClient). That is not an optimisation: on this
+// platform it is the only thing that can end the read at all, because
+// containerd's client never closes its end of the stdin pipe. Without it a
+// container with attached stdio takes the full ioShutdown ceiling -- 30 s,
+// measured on Windows 11, 2026-08-14 -- to be deleted after its process has
+// already been reaped and its output already relayed.
+//
 // Reconnecting is only correct when the copy ended because the client
 // went away. If it ended because writing to the guest-facing stream
 // failed, the loop stops instead -- see writeErrRecorder.
@@ -213,8 +292,18 @@ func copyStreams(ctx context.Context, streams [3]io.ReadWriteCloser, stdin, stdo
 		// the guest instead of waiting for a new client to reconnect.
 		closeRequested := make(chan struct{})
 		var closeOnce sync.Once
+		// client holds the connection the copy goroutine is reading, so
+		// stdinEOF can end a read that is already in flight. Only named
+		// pipes are tracked: a plain file always reaches EOF on its own,
+		// and closing one mid-copy could truncate a stdin redirect that is
+		// still being read.
+		client := &stdinClient{}
+		if namedPipe {
+			client.attach(f)
+		}
 		stdinEOF = func() error {
 			closeOnce.Do(func() { close(closeRequested) })
+			client.requestEOF()
 			return nil
 		}
 
@@ -234,7 +323,7 @@ func copyStreams(ctx context.Context, streams [3]io.ReadWriteCloser, stdin, stdo
 				// what unblocks this read, so every byte buffered before
 				// EOF is forwarded before we either reconnect or deliver
 				// the in-band CloseWrite below.
-				if _, err := io.CopyBuffer(w, f, *p); err != nil {
+				if _, err := io.CopyBuffer(w, f, *p); err != nil && !client.endedByEOF() {
 					log.G(ctx).WithError(err).Warn("error copying stdin")
 				}
 				f.Close()
@@ -284,6 +373,13 @@ func copyStreams(ctx context.Context, streams [3]io.ReadWriteCloser, stdin, stdo
 					}
 					break readLoop
 				}
+				// The dial and stdinEOF can complete in either order.
+				// If stdinEOF won, the new client is closed rather than
+				// read: reading it would block on a connection nothing
+				// will ever end.
+				if !client.attach(conn) {
+					break readLoop
+				}
 				f = conn
 			}
 
diff --git a/internal/shim/task/io_copystreams_windows_test.go b/internal/shim/task/io_copystreams_windows_test.go
index b957f0b..90ffb7a 100644
--- a/internal/shim/task/io_copystreams_windows_test.go
+++ b/internal/shim/task/io_copystreams_windows_test.go
@@ -180,6 +180,86 @@ func TestCopyStreamsStdinDetachReattach(t *testing.T) {
 	require.Equal(t, "firstsecond", data, "expected data from both the pre-detach and post-reattach writers")
 }
 
+// TestCopyStreamsStdinEOFWithClientAttached is the regression test for the
+// 30 s teardown stall measured on Windows 11 on 2026-08-14: every container
+// with attached stdio took the full ioShutdown ceiling to be deleted, long
+// after its process had been reaped and its output relayed.
+//
+// The client here behaves exactly as containerd's own client-side stdio does
+// (pkg/cio/io_windows.go): it accepts the stdin connection, writes, and then
+// keeps the connection open forever, because its copy goroutine is blocked on
+// an os.Stdin that a console never EOFs and nothing in cio's Close or Cancel
+// touches the accepted connection. Nothing but stdinEOF can end the shim's
+// read of that connection, so if stdinEOF does not close it, stdinDone never
+// closes and forwardIO's shutdown waits its whole budget.
+//
+// It also pins the ordering that makes closing safe: bytes written before
+// stdinEOF must already have been relayed to the guest.
+func TestCopyStreamsStdinEOFWithClientAttached(t *testing.T) {
+	pipePath := testPipeName(t)
+	l, err := winio.ListenPipe(pipePath, &winio.PipeConfig{
+		InputBufferSize:  4096,
+		OutputBufferSize: 4096,
+	})
+	require.NoError(t, err, "ListenPipe")
+	defer l.Close()
+
+	accepted := make(chan error, 1)
+	// hold keeps the client's end of the pipe open until the test is over,
+	// the way containerd's cio holds its own for the life of the process.
+	hold := make(chan struct{})
+	t.Cleanup(func() { close(hold) })
+	go func() {
+		conn, err := l.Accept()
+		if err != nil {
+			accepted <- fmt.Errorf("accept: %w", err)
+			return
+		}
+		// Deliberately never closed: this is the client that hangs on to
+		// its end of the pipe for the life of the process.
+		defer conn.Close()
+		if _, err := conn.Write([]byte("hello")); err != nil {
+			accepted <- fmt.Errorf("write: %w", err)
+			return
+		}
+		accepted <- nil
+		<-hold
+	}()
+
+	sc := newFakeStdinStream()
+	streams := [3]io.ReadWriteCloser{sc, nil, nil}
+	ioDone := make(chan struct{})
+
+	stdinEOF, stdinDone, err := copyStreams(context.Background(), streams, pipePath, "", "", ioDone)
+	require.NoError(t, err, "copyStreams")
+	require.NoError(t, <-accepted, "writer")
+
+	// Wait for the write to be relayed, so the copy goroutine is parked in
+	// a read on a connection that will never end by itself -- the exact
+	// state the stall was measured in.
+	require.Eventually(t, func() bool {
+		data, _ := sc.snapshot()
+		return data == "hello"
+	}, 5*time.Second, 10*time.Millisecond, "expected the client's write to be relayed to the guest")
+
+	if _, eof := sc.snapshot(); eof {
+		t.Fatal("stdin EOF (CloseWrite) delivered before stdinEOF was called")
+	}
+
+	require.NoError(t, stdinEOF())
+
+	select {
+	case <-stdinDone:
+	case <-time.After(5 * time.Second):
+		t.Fatal("stdinDone did not close after stdinEOF while a client was still attached; " +
+			"the shim is waiting for a disconnect that will never come")
+	}
+
+	data, eof := sc.snapshot()
+	require.True(t, eof, "expected CloseWrite to have been called after stdinEOF")
+	require.Equal(t, "hello", data, "bytes written before stdinEOF must be relayed, not truncated by the close")
+}
+
 // TestCopyStreamsStdinCloseWithoutDetach verifies the simple case (no
 // detach involved): a single client writes and disconnects, then stdinEOF
 // is called; the guest-facing stream must have received the data and EOF.
