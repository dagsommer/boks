# Jekyll and the GFM parser, and nothing else. No theme gem: the layouts and stylesheet in
# this directory are the whole design, which is how the site stays free of remote fonts,
# CDNs and analytics that a third-party theme would pull in without asking.
source "https://rubygems.org"

gem "jekyll", "~> 4.4"
gem "kramdown-parser-gfm", "~> 1.1"
